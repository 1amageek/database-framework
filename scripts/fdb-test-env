#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${FDB_TEST_STATE_DIR:-"$ROOT_DIR/.fdb-test"}"
PORT="${FDB_TEST_PORT:-4699}"
STATUS_TIMEOUT_SECONDS="${FDB_TEST_STATUS_TIMEOUT_SECONDS:-20}"
STARTUP_TIMEOUT_SECONDS="${FDB_TEST_STARTUP_TIMEOUT_SECONDS:-90}"
CONFIGURATION_TIMEOUT_SECONDS="${FDB_TEST_CONFIGURATION_TIMEOUT_SECONDS:-90}"
MIN_AVAILABLE_SPACE_RATIO="${FDB_TEST_MIN_AVAILABLE_SPACE_RATIO:-0.0}"
XCODE_TIMEOUT_SECONDS="${FDB_TEST_XCODE_TIMEOUT_SECONDS:-120}"
EXPECTED_TEST_COUNT="${FDB_TEST_EXPECTED_COUNT:-}"
CLUSTER_FILE="$STATE_DIR/fdb.cluster"
DATA_DIR="$STATE_DIR/data"
LOG_DIR="$STATE_DIR/logs"
PID_FILE="$STATE_DIR/fdb.pid"
PID_IDENTITY_FILE="$STATE_DIR/fdb.pid.identity"
ENV_FILE="$STATE_DIR/env"

FDBSERVER="${FDBSERVER:-}"
FDBCLI="${FDBCLI:-}"

usage() {
  cat <<EOF
Usage:
  scripts/fdb-test-env start [--clean]
  scripts/fdb-test-env stop [--clean]
  scripts/fdb-test-env status
  scripts/fdb-test-env env
  scripts/fdb-test-env run [--clean] -- <command> [args...]
  scripts/fdb-test-env xcode-test [--clean] -- <file.xctestrun> [xcodebuild options...]
  scripts/fdb-test-env shell [--clean]

Environment:
  FDB_TEST_PORT       Port for the isolated local cluster. Default: 4699
  FDB_TEST_STATE_DIR  State directory. Default: .fdb-test
  FDB_TEST_STATUS_TIMEOUT_SECONDS
                      Individual cluster status timeout. Default: 20
  FDB_TEST_STARTUP_TIMEOUT_SECONDS
                      Database availability deadline. Default: 90
  FDB_TEST_CONFIGURATION_TIMEOUT_SECONDS
                      Initial cluster configuration deadline. Default: 90
  FDB_TEST_MIN_AVAILABLE_SPACE_RATIO
                      Ephemeral cluster disk reserve ratio. Default: 0.0
  FDB_TEST_XCODE_TIMEOUT_SECONDS
                      test-without-building timeout. Default: 120
  FDB_TEST_EXPECTED_COUNT
                      Exact test count required from the xcresult. Optional.
  FDBSERVER           Override fdbserver path
  FDBCLI              Override fdbcli path
EOF
}

find_executable() {
  local configured="$1"
  local name="$2"
  shift 2

  if [[ -n "$configured" && -x "$configured" ]]; then
    printf '%s\n' "$configured"
    return 0
  fi

  local path
  for path in "$@"; do
    if [[ -x "$path" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done

  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi

  echo "error: $name not found" >&2
  return 1
}

fdbserver_path() {
  find_executable "$FDBSERVER" fdbserver \
    /usr/local/libexec/fdbserver \
    /usr/local/libexec/foundationdb/fdbserver \
    /opt/homebrew/libexec/fdbserver \
    /opt/homebrew/libexec/foundationdb/fdbserver \
    /usr/sbin/fdbserver \
    /usr/local/sbin/fdbserver
}

fdbcli_path() {
  find_executable "$FDBCLI" fdbcli \
    /usr/local/bin/fdbcli \
    /opt/homebrew/bin/fdbcli \
    /usr/local/libexec/foundationdb/fdbcli \
    /opt/homebrew/libexec/foundationdb/fdbcli \
    /usr/bin/fdbcli
}

timeout_cmd() {
  local seconds="$1"
  shift
  perl -e 'alarm shift; exec @ARGV' "$seconds" "$@"
}

is_alive() {
  [[ -f "$PID_FILE" ]] || return 1
  [[ -f "$PID_IDENTITY_FILE" ]] || return 1
  local pid
  pid="$(tr -d '[:space:]' < "$PID_FILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1 || return 1

  local stored_start
  local stored_server
  local stored_cluster
  local stored_port
  stored_start="$(sed -n '1p' "$PID_IDENTITY_FILE")"
  stored_server="$(sed -n '2p' "$PID_IDENTITY_FILE")"
  stored_cluster="$(sed -n '3p' "$PID_IDENTITY_FILE")"
  stored_port="$(sed -n '4p' "$PID_IDENTITY_FILE")"

  [[ -n "$stored_start" && -n "$stored_server" ]] || return 1
  [[ "$stored_cluster" == "$CLUSTER_FILE" ]] || return 1
  [[ "$stored_port" == "$PORT" ]] || return 1

  local current_start
  local command_line
  current_start="$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//')"
  command_line="$(ps -ww -p "$pid" -o command= 2>/dev/null)"
  [[ "$current_start" == "$stored_start" ]] || return 1
  [[ "$command_line" == "$stored_server "* ]] || return 1
  [[ "$command_line" == *" -C $stored_cluster "* ]] || return 1
  [[ "$command_line" == *" -p auto:$stored_port "* ]] || return 1
}

is_available() {
  [[ -f "$CLUSTER_FILE" ]] || return 1
  local status
  if ! status="$(
    timeout_cmd "$STATUS_TIMEOUT_SECONDS" \
      "$(fdbcli_path)" -C "$CLUSTER_FILE" --exec 'status minimal' 2>/dev/null
  )"; then
    return 1
  fi

  grep -Eq '^The database is available\.$' <<<"$status"
}

wait_for_available() {
  local deadline=$((SECONDS + STARTUP_TIMEOUT_SECONDS))
  while (( SECONDS < deadline )); do
    if is_available; then
      return 0
    fi
    sleep 0.5
  done

  echo "error: FoundationDB did not become available" >&2
  echo "cluster: $CLUSTER_FILE" >&2
  echo "last logs:" >&2
  find "$LOG_DIR" -maxdepth 1 -type f -name 'trace*.xml' -print0 2>/dev/null \
    | xargs -0 ls -t 2>/dev/null \
    | head -1 \
    | xargs tail -80 2>/dev/null || true
  return 1
}

configure_cluster() {
  local cli="$1"
  local deadline=$((SECONDS + CONFIGURATION_TIMEOUT_SECONDS))
  local output="$STATE_DIR/configure.out"
  local error_output="$STATE_DIR/configure.err"

  while (( SECONDS < deadline )); do
    if timeout_cmd 10 "$cli" -C "$CLUSTER_FILE" --exec 'configure new single memory' >"$output" 2>"$error_output"; then
      return 0
    fi

    if grep -Eqi 'already.*configured|database.*exists' "$output" "$error_output" 2>/dev/null; then
      return 0
    fi

    sleep 0.5
  done

  echo "error: FoundationDB configure did not complete" >&2
  cat "$output" >&2 2>/dev/null || true
  cat "$error_output" >&2 2>/dev/null || true
  return 1
}

write_env_file() {
  cat > "$ENV_FILE" <<EOF
export FDB_CLUSTER_FILE="$CLUSTER_FILE"
EOF
}

inject_cluster_file_into_xctestrun() {
  local xctestrun="$1"
  local configuration_index=0
  local target_count=0
  local swiftc
  local toolchain_root
  local testing_library_path
  if [[ -n "${TOOLCHAINS:-}" ]]; then
    swiftc="$(xcrun --toolchain "$TOOLCHAINS" --find swiftc)"
  else
    swiftc="$(command -v swiftc)"
  fi
  toolchain_root="$(cd "$(dirname "$swiftc")/../.." && pwd)"
  testing_library_path="$toolchain_root/usr/lib/swift/macosx/testing"

  if [[ ! -f "$testing_library_path/libTesting.dylib" ]]; then
    testing_library_path=""
  fi

  while plutil -extract "TestConfigurations.$configuration_index.Name" raw \
      "$xctestrun" >/dev/null 2>&1; do
    local target_index=0
    while plutil -extract \
        "TestConfigurations.$configuration_index.TestTargets.$target_index.BlueprintName" \
        raw "$xctestrun" >/dev/null 2>&1; do
      local environment_path="TestConfigurations.$configuration_index.TestTargets.$target_index.EnvironmentVariables"
      local cluster_path="$environment_path.FDB_CLUSTER_FILE"

      if ! plutil -extract "$environment_path" xml1 -o /dev/null \
          "$xctestrun" >/dev/null 2>&1; then
        plutil -insert "$environment_path" -xml '<dict/>' "$xctestrun"
      fi

      if plutil -extract "$cluster_path" raw "$xctestrun" >/dev/null 2>&1; then
        plutil -replace "$cluster_path" -string "$CLUSTER_FILE" "$xctestrun"
      else
        plutil -insert "$cluster_path" -string "$CLUSTER_FILE" "$xctestrun"
      fi

      if [[ -n "$testing_library_path" ]]; then
        prepend_testing_library_path \
          "$xctestrun" \
          "TestConfigurations.$configuration_index.TestTargets.$target_index.TestingEnvironmentVariables" \
          "$testing_library_path"
      fi

      target_count=$((target_count + 1))
      target_index=$((target_index + 1))
    done
    configuration_index=$((configuration_index + 1))
  done

  # Xcode emits the legacy format with each test target as a top-level
  # dictionary. Detect target dictionaries by their BlueprintName contract.
  local top_level_key
  while IFS= read -r top_level_key; do
    if ! plutil -extract "$top_level_key.BlueprintName" raw \
        "$xctestrun" >/dev/null 2>&1; then
      continue
    fi

    local environment_path="$top_level_key.EnvironmentVariables"
    local cluster_path="$environment_path.FDB_CLUSTER_FILE"
    if ! plutil -extract "$environment_path" xml1 -o /dev/null \
        "$xctestrun" >/dev/null 2>&1; then
      plutil -insert "$environment_path" -xml '<dict/>' "$xctestrun"
    fi

    if plutil -extract "$cluster_path" raw "$xctestrun" >/dev/null 2>&1; then
      plutil -replace "$cluster_path" -string "$CLUSTER_FILE" "$xctestrun"
    else
      plutil -insert "$cluster_path" -string "$CLUSTER_FILE" "$xctestrun"
    fi
    if [[ -n "$testing_library_path" ]]; then
      prepend_testing_library_path \
        "$xctestrun" \
        "$top_level_key.TestingEnvironmentVariables" \
        "$testing_library_path"
    fi
    target_count=$((target_count + 1))
  done < <(
    plutil -p "$xctestrun" \
      | sed -n 's/^  "\([^"]*\)" => {$/\1/p'
  )

  if (( target_count == 0 )); then
    echo "error: no test targets found in $xctestrun" >&2
    return 1
  fi
}

prepend_testing_library_path() {
  local xctestrun="$1"
  local environment_path="$2"
  local library_path="$3"
  local variable_path="$environment_path.DYLD_LIBRARY_PATH"
  local existing_value=""

  if ! plutil -extract "$environment_path" xml1 -o /dev/null \
      "$xctestrun" >/dev/null 2>&1; then
    plutil -insert "$environment_path" -xml '<dict/>' "$xctestrun"
  fi

  if existing_value="$(plutil -extract "$variable_path" raw "$xctestrun" 2>/dev/null)"; then
    plutil -replace "$variable_path" -string "$library_path:$existing_value" "$xctestrun"
  else
    plutil -insert "$variable_path" -string "$library_path" "$xctestrun"
  fi
}

run_xcode_tests() {
  local clean="$1"
  shift

  if [[ $# -eq 0 ]]; then
    echo "error: xcode-test requires an xctestrun file" >&2
    return 2
  fi
  if ! command -v xcodebuild >/dev/null 2>&1 || ! command -v plutil >/dev/null 2>&1; then
    echo "error: xcode-test requires xcodebuild and plutil" >&2
    return 1
  fi

  local source_xctestrun="$1"
  shift
  if [[ ! -f "$source_xctestrun" ]]; then
    echo "error: xctestrun file not found: $source_xctestrun" >&2
    return 1
  fi

  local source_directory
  local source_name
  source_directory="$(cd "$(dirname "$source_xctestrun")" && pwd)"
  source_name="$(basename "$source_xctestrun")"
  source_xctestrun="$source_directory/$source_name"

  start_cluster "$clean"

  # Keep the derived test specification beside the generated file so that
  # __TESTROOT__ continues to resolve to the build-for-testing products.
  local isolated_xctestrun="$source_directory/.fdb-isolated-$$.xctestrun"
  local result_bundle="$STATE_DIR/results/xcode-$(date +%Y%m%d-%H%M%S)-$$.xcresult"
  cp "$source_xctestrun" "$isolated_xctestrun"
  inject_cluster_file_into_xctestrun "$isolated_xctestrun"
  mkdir -p "$(dirname "$result_bundle")"

  local cleanup_command
  printf -v cleanup_command 'rm -f %q; stop_cluster false' "$isolated_xctestrun"
  trap "$cleanup_command" EXIT
  set +e
  timeout_cmd "$XCODE_TIMEOUT_SECONDS" \
    xcodebuild test-without-building \
      -xctestrun "$isolated_xctestrun" \
      -resultBundlePath "$result_bundle" \
      "$@"
  local test_status=$?
  set -e
  if (( test_status != 0 )); then
    return "$test_status"
  fi

  local total_test_count
  if ! total_test_count="$(
    xcrun xcresulttool get test-results summary \
      --path "$result_bundle" \
      --format json \
      | plutil -extract totalTestCount raw -
  )"; then
    echo "error: unable to read test count from $result_bundle" >&2
    return 1
  fi
  if ! [[ "$total_test_count" =~ ^[0-9]+$ ]] || (( total_test_count == 0 )); then
    echo "error: xcodebuild executed zero tests" >&2
    echo "result bundle: $result_bundle" >&2
    return 1
  fi
  if [[ -n "$EXPECTED_TEST_COUNT" ]] \
      && [[ "$total_test_count" != "$EXPECTED_TEST_COUNT" ]]; then
    echo "error: expected $EXPECTED_TEST_COUNT tests, executed $total_test_count" >&2
    echo "result bundle: $result_bundle" >&2
    return 1
  fi
  echo "Executed tests: $total_test_count"
  echo "Result bundle: $result_bundle"
}

start_cluster() {
  local clean="$1"
  local server
  local cli
  server="$(fdbserver_path)"
  cli="$(fdbcli_path)"

  if is_alive; then
    if [[ "$clean" == true ]]; then
      stop_cluster false
    elif is_available || wait_for_available; then
      write_env_file
      echo "FoundationDB test cluster already running"
      echo "FDB_CLUSTER_FILE=$CLUSTER_FILE"
      return 0
    else
      stop_cluster false
    fi
  fi

  if [[ "$clean" == true ]]; then
    rm -rf "$STATE_DIR"
  fi

  mkdir -p "$DATA_DIR/$PORT" "$LOG_DIR"
  printf 'local:local%s@127.0.0.1:%s\n' "$(date +%s)" "$PORT" > "$CLUSTER_FILE"

  nohup "$server" \
    -p "auto:$PORT" \
    -C "$CLUSTER_FILE" \
    -d "$DATA_DIR/$PORT" \
    -L "$LOG_DIR" \
    --machine-id test \
    --datacenter-id test \
    --class storage \
    --knob_min_available_space_ratio="$MIN_AVAILABLE_SPACE_RATIO" \
    >"$STATE_DIR/fdbserver.out" 2>&1 &

  local pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"
  local process_start
  process_start="$(ps -p "$pid" -o lstart= | sed 's/^[[:space:]]*//')"
  printf '%s\n%s\n%s\n%s\n' \
    "$process_start" "$server" "$CLUSTER_FILE" "$PORT" \
    > "$PID_IDENTITY_FILE"
  disown "$pid" 2>/dev/null || true

  sleep 1
  configure_cluster "$cli"
  wait_for_available
  write_env_file

  echo "FoundationDB test cluster running"
  echo "FDB_CLUSTER_FILE=$CLUSTER_FILE"
}

stop_cluster() {
  local clean="$1"

  if is_alive; then
    local pid
    pid="$(tr -d '[:space:]' < "$PID_FILE")"
    kill "$pid" >/dev/null 2>&1 || true

    local deadline=$((SECONDS + 10))
    while is_alive && (( SECONDS < deadline )); do
      sleep 0.2
    done
    if is_alive; then
      kill -9 "$pid" >/dev/null 2>&1 || true
    fi
    wait "$pid" 2>/dev/null || true
  fi

  rm -f "$PID_FILE" "$PID_IDENTITY_FILE"
  if [[ "$clean" == true ]]; then
    rm -rf "$STATE_DIR"
  fi
}

status_cluster() {
  if ! [[ -f "$CLUSTER_FILE" ]]; then
    echo "FoundationDB test cluster is not initialized"
    return 1
  fi

  if is_alive && is_available; then
    "$(fdbcli_path)" -C "$CLUSTER_FILE" --exec 'status minimal'
    echo "FDB_CLUSTER_FILE=$CLUSTER_FILE"
    return 0
  fi

  echo "FoundationDB test cluster is not running or not healthy"
  echo "FDB_CLUSTER_FILE=$CLUSTER_FILE"
  return 1
}

print_env() {
  if [[ -f "$ENV_FILE" ]]; then
    cat "$ENV_FILE"
  else
    echo "export FDB_CLUSTER_FILE=\"$CLUSTER_FILE\""
  fi
}

command="${1:-}"
shift || true

clean=false
if [[ "${1:-}" == "--clean" ]]; then
  clean=true
  shift
fi

case "$command" in
  start)
    start_cluster "$clean"
    ;;
  stop)
    stop_cluster "$clean"
    ;;
  status)
    status_cluster
    ;;
  env)
    print_env
    ;;
  run)
    if [[ "${1:-}" == "--clean" ]]; then
      clean=true
      shift
    fi
    if [[ "${1:-}" == "--" ]]; then
      shift
    fi
    if [[ $# -eq 0 ]]; then
      usage
      exit 2
    fi
    start_cluster "$clean"
    trap 'stop_cluster false' EXIT
    FDB_CLUSTER_FILE="$CLUSTER_FILE" "$@"
    ;;
  xcode-test)
    if [[ "${1:-}" == "--clean" ]]; then
      clean=true
      shift
    fi
    if [[ "${1:-}" == "--" ]]; then
      shift
    fi
    run_xcode_tests "$clean" "$@"
    ;;
  shell)
    start_cluster "$clean"
    trap 'stop_cluster false' EXIT
    echo "Entering shell with FDB_CLUSTER_FILE=$CLUSTER_FILE"
    FDB_CLUSTER_FILE="$CLUSTER_FILE" "${SHELL:-/bin/sh}"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
