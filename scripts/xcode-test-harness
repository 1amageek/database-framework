#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCHEME="database-framework-Package"
DESTINATION="platform=macOS,arch=arm64"
TRAITS=""
EXPECTED_TEST_COUNT=""
EXPECTED_TARGET_COUNTS=()
EXPECTED_TARGET_COUNT_SIZE=0
TOOLCHAIN_IDENTIFIER="org.swift.64202608141a"
XCODE_TOOLCHAIN_IDENTIFIER="com.apple.dt.toolchain.XcodeDefault"
REQUIRE_ZERO_SKIPS=false
REQUIRE_ZERO_EXPECTED_FAILURES=false
REQUIRE_ZERO_RUNTIME_WARNINGS=false
BUILD_TIMEOUT_SECONDS="${XCODE_TEST_BUILD_TIMEOUT_SECONDS:-1200}"
TEST_TIMEOUT_SECONDS="${XCODE_TEST_TIMEOUT_SECONDS:-1200}"
RESOLVE_TIMEOUT_SECONDS="${XCODE_TEST_RESOLVE_TIMEOUT_SECONDS:-600}"
RESULT_DIRECTORY="${XCODE_TEST_RESULT_DIRECTORY:-${TMPDIR:-/tmp}/database-framework-xcode-results}"
ONLY_TESTING=()
SKIP_TESTING=()
ADDITIONAL_XCODEBUILD_ARGUMENTS=()
XCODE_HARNESS_WORK_ROOT=""
HARNESS_LOCK_DIRECTORY=""
HARNESS_LOCK_OWNED=false
PRESERVE_WORK_ROOT=false
REUSE_WORK_ROOT=""
REUSE_BUILT_TESTS=false

usage() {
  cat <<'EOF'
Usage:
  scripts/xcode-test-harness --traits <trait-list> [options]

Required:
  --traits <list>              Comma-separated SwiftPM traits.

Options:
  --scheme <name>              Xcode scheme. Default: database-framework-Package
  --destination <destination>  Xcode destination. Default: platform=macOS,arch=arm64
  --only-testing <identifier>  Include one test identifier. Repeatable.
  --skip-testing <identifier>  Exclude one test identifier. Repeatable.
  --expected-count <count>     Require an exact executed-test count.
  --expected-target-count <target=count>
                               Require an exact count for one test bundle.
                               Repeatable; their sum must equal the total count.
  --require-zero-skips         Fail when any selected test is skipped.
  --require-zero-expected-failures
                               Fail when any expected failure is recorded.
  --require-zero-runtime-warnings
                               Fail when the result contains runtime warnings.
  --build-timeout <seconds>    build-for-testing timeout. Default: 1200
  --test-timeout <seconds>     test-without-building timeout. Default: 1200
  --resolve-timeout <seconds>  SwiftPM resolution timeout. Default: 600
  --result-directory <path>    Persistent result directory outside the temporary copy.
  --preserve-work-root         Keep the isolated source and DerivedData for focused reruns.
  --reuse-work-root <path>     Reuse a previously preserved harness work root.
  --reuse-built-tests          Skip build-for-testing only when the preserved
                               build input fingerprint matches exactly.
  --                           Pass remaining arguments to both xcodebuild invocations.

Recognized test environment variables are copied into every generated test
target: FDB_CLUSTER_FILE and POSTGRES_TEST_*.
EOF
}

require_value() {
  local option="$1"
  local value="${2:-}"
  if [[ -z "$value" ]]; then
    echo "error: $option requires a value" >&2
    exit 2
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --traits)
      require_value "$1" "${2:-}"
      TRAITS="$2"
      shift 2
      ;;
    --scheme)
      require_value "$1" "${2:-}"
      SCHEME="$2"
      shift 2
      ;;
    --destination)
      require_value "$1" "${2:-}"
      DESTINATION="$2"
      shift 2
      ;;
    --only-testing)
      require_value "$1" "${2:-}"
      ONLY_TESTING+=("$2")
      shift 2
      ;;
    --skip-testing)
      require_value "$1" "${2:-}"
      SKIP_TESTING+=("$2")
      shift 2
      ;;
    --expected-count)
      require_value "$1" "${2:-}"
      EXPECTED_TEST_COUNT="$2"
      shift 2
      ;;
    --expected-target-count)
      require_value "$1" "${2:-}"
      EXPECTED_TARGET_COUNTS+=("$2")
      EXPECTED_TARGET_COUNT_SIZE=$((EXPECTED_TARGET_COUNT_SIZE + 1))
      shift 2
      ;;
    --require-zero-skips)
      REQUIRE_ZERO_SKIPS=true
      shift
      ;;
    --require-zero-expected-failures)
      REQUIRE_ZERO_EXPECTED_FAILURES=true
      shift
      ;;
    --require-zero-runtime-warnings)
      REQUIRE_ZERO_RUNTIME_WARNINGS=true
      shift
      ;;
    --build-timeout)
      require_value "$1" "${2:-}"
      BUILD_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    --test-timeout)
      require_value "$1" "${2:-}"
      TEST_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    --resolve-timeout)
      require_value "$1" "${2:-}"
      RESOLVE_TIMEOUT_SECONDS="$2"
      shift 2
      ;;
    --result-directory)
      require_value "$1" "${2:-}"
      RESULT_DIRECTORY="$2"
      shift 2
      ;;
    --preserve-work-root)
      PRESERVE_WORK_ROOT=true
      shift
      ;;
    --reuse-work-root)
      require_value "$1" "${2:-}"
      REUSE_WORK_ROOT="$2"
      PRESERVE_WORK_ROOT=true
      shift 2
      ;;
    --reuse-built-tests)
      REUSE_BUILT_TESTS=true
      shift
      ;;
    --)
      shift
      ADDITIONAL_XCODEBUILD_ARGUMENTS=("$@")
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$TRAITS" ]]; then
  echo "error: --traits is required" >&2
  exit 2
fi
if [[ "$REUSE_BUILT_TESTS" == true && -z "$REUSE_WORK_ROOT" ]]; then
  echo "error: --reuse-built-tests requires --reuse-work-root" >&2
  exit 2
fi
if ! [[ "$EXPECTED_TEST_COUNT" =~ ^[0-9]*$ ]]; then
  echo "error: --expected-count must be a non-negative integer" >&2
  exit 2
fi
if (( EXPECTED_TARGET_COUNT_SIZE > 0 )); then
  for expected_target_count in "${EXPECTED_TARGET_COUNTS[@]}"; do
    if ! [[ "$expected_target_count" =~ ^[A-Za-z_][A-Za-z0-9_.-]*=(0|[1-9][0-9]*)$ ]]; then
      echo "error: --expected-target-count must use target=count" >&2
      exit 2
    fi
    expected_target="${expected_target_count%%=*}"
    duplicate_count=0
    for candidate in "${EXPECTED_TARGET_COUNTS[@]}"; do
      if [[ "${candidate%%=*}" == "$expected_target" ]]; then
        duplicate_count=$((duplicate_count + 1))
      fi
    done
    if (( duplicate_count != 1 )); then
      echo "error: duplicate expected target count: $expected_target" >&2
      exit 2
    fi
  done
fi
if ! [[ "$BUILD_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
  echo "error: --build-timeout must be a positive integer" >&2
  exit 2
fi
if ! [[ "$TEST_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
  echo "error: --test-timeout must be a positive integer" >&2
  exit 2
fi
if ! [[ "$RESOLVE_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
  echo "error: --resolve-timeout must be a positive integer" >&2
  exit 2
fi

timeout_command() {
  local seconds="$1"
  shift
  perl -e 'alarm shift; exec @ARGV' "$seconds" "$@"
}

cleanup() {
  if [[ -z "$XCODE_HARNESS_WORK_ROOT" || ! -d "$XCODE_HARNESS_WORK_ROOT" ]]; then
    return
  fi
  if [[ "$HARNESS_LOCK_OWNED" == true \
      && -n "$HARNESS_LOCK_DIRECTORY" \
      && "$HARNESS_LOCK_DIRECTORY" == "$XCODE_HARNESS_WORK_ROOT/.harness-lock" \
      && -d "$HARNESS_LOCK_DIRECTORY" ]]; then
    rm -f -- "$HARNESS_LOCK_DIRECTORY/owner-pid"
    rmdir "$HARNESS_LOCK_DIRECTORY" 2>/dev/null || true
    HARNESS_LOCK_DIRECTORY=""
    HARNESS_LOCK_OWNED=false
  fi
  if [[ "$PRESERVE_WORK_ROOT" == true ]]; then
    echo "Preserved harness work root: $XCODE_HARNESS_WORK_ROOT" >&2
    return
  fi
  local temporary_root="${TMPDIR:-/tmp}"
  temporary_root="${temporary_root%/}"
  local expected_prefix="$temporary_root/database-framework-xcode-test."
  if [[ "$XCODE_HARNESS_WORK_ROOT" != "$expected_prefix"* ]]; then
    echo "error: refusing to remove unexpected harness path: $XCODE_HARNESS_WORK_ROOT" >&2
    return
  fi
  rm -rf -- "$XCODE_HARNESS_WORK_ROOT"
}

trap cleanup EXIT

trait_literal() {
  local input="$1"
  local output="["
  local separator=""
  local trait
  local traits=()
  IFS=',' read -r -a traits <<<"$input"
  if (( ${#traits[@]} == 0 )); then
    echo "error: no traits were provided" >&2
    return 1
  fi
  for trait in "${traits[@]}"; do
    if ! [[ "$trait" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]]; then
      echo "error: invalid trait name: $trait" >&2
      return 1
    fi
    output+="$separator\"$trait\""
    separator=", "
  done
  output+="]"
  printf '%s\n' "$output"
}

set_plist_string() {
  local plist="$1"
  local dictionary_path="$2"
  local key="$3"
  local value="$4"
  local value_path="$dictionary_path.$key"

  if ! plutil -extract "$dictionary_path" xml1 -o /dev/null \
      "$plist" >/dev/null 2>&1; then
    plutil -insert "$dictionary_path" -xml '<dict/>' "$plist"
  fi
  if plutil -extract "$value_path" raw "$plist" >/dev/null 2>&1; then
    plutil -replace "$value_path" -string "$value" "$plist"
  else
    plutil -insert "$value_path" -string "$value" "$plist"
  fi
}

prepend_testing_library_path() {
  local plist="$1"
  local dictionary_path="$2"
  local library_path="$3"
  local value_path="$dictionary_path.DYLD_LIBRARY_PATH"
  local existing_value=""

  if ! plutil -extract "$dictionary_path" xml1 -o /dev/null \
      "$plist" >/dev/null 2>&1; then
    plutil -insert "$dictionary_path" -xml '<dict/>' "$plist"
  fi
  if existing_value="$(plutil -extract "$value_path" raw "$plist" 2>/dev/null)"; then
    plutil -replace "$value_path" \
      -string "$library_path:$existing_value" "$plist"
  else
    plutil -insert "$value_path" -string "$library_path" "$plist"
  fi
}

inject_environment() {
  local plist="$1"
  local target_count=0
  local configuration_index=0
  local environment_keys=(
    FDB_CLUSTER_FILE
    POSTGRES_TEST_UNIX_SOCKET
    POSTGRES_TEST_HOST
    POSTGRES_TEST_PORT
    POSTGRES_TEST_USER
    POSTGRES_TEST_PASSWORD
    POSTGRES_TEST_DB
  )
  local swiftc
  local toolchain_root
  local testing_library_path=""
  local fdb_library_path=""

  swiftc="$(xcrun --toolchain "$TOOLCHAIN_IDENTIFIER" --find swiftc)"
  toolchain_root="$(cd "$(dirname "$swiftc")/../.." && pwd)"
  if [[ -f "$toolchain_root/usr/lib/swift/macosx/testing/libTesting.dylib" ]]; then
    testing_library_path="$toolchain_root/usr/lib/swift/macosx/testing"
  fi
  if [[ -n "${FDB_CLUSTER_FILE:-}" ]]; then
    local candidate
    for candidate in \
        "${FDB_CLIENT_LIBRARY_DIRECTORY:-}" \
        /usr/local/lib \
        /opt/homebrew/lib; do
      if [[ -n "$candidate" && -f "$candidate/libfdb_c.dylib" ]]; then
        fdb_library_path="$candidate"
        break
      fi
    done
    if [[ -z "$fdb_library_path" ]]; then
      echo "error: FDB_CLUSTER_FILE is set but libfdb_c.dylib was not found" >&2
      return 1
    fi
  fi

  while plutil -extract "TestConfigurations.$configuration_index.Name" raw \
      "$plist" >/dev/null 2>&1; do
    local target_index=0
    while plutil -extract \
        "TestConfigurations.$configuration_index.TestTargets.$target_index.BlueprintName" \
        raw "$plist" >/dev/null 2>&1; do
      local target_path="TestConfigurations.$configuration_index.TestTargets.$target_index"
      local key
      local value
      for key in "${environment_keys[@]}"; do
        if value="$(printenv "$key")"; then
          set_plist_string "$plist" "$target_path.EnvironmentVariables" "$key" "$value"
        fi
      done
      if [[ -n "$testing_library_path" ]]; then
        prepend_testing_library_path \
          "$plist" "$target_path.TestingEnvironmentVariables" "$testing_library_path"
      fi
      if [[ -n "$fdb_library_path" ]]; then
        prepend_testing_library_path \
          "$plist" "$target_path.TestingEnvironmentVariables" "$fdb_library_path"
      fi
      target_count=$((target_count + 1))
      target_index=$((target_index + 1))
    done
    configuration_index=$((configuration_index + 1))
  done

  local top_level_key
  while IFS= read -r top_level_key; do
    if ! plutil -extract "$top_level_key.BlueprintName" raw \
        "$plist" >/dev/null 2>&1; then
      continue
    fi
    local key
    local value
    for key in "${environment_keys[@]}"; do
      if value="$(printenv "$key")"; then
        set_plist_string "$plist" "$top_level_key.EnvironmentVariables" "$key" "$value"
      fi
    done
    if [[ -n "$testing_library_path" ]]; then
      prepend_testing_library_path \
        "$plist" "$top_level_key.TestingEnvironmentVariables" "$testing_library_path"
    fi
    if [[ -n "$fdb_library_path" ]]; then
      prepend_testing_library_path \
        "$plist" "$top_level_key.TestingEnvironmentVariables" "$fdb_library_path"
    fi
    target_count=$((target_count + 1))
  done < <(
    plutil -p "$plist" \
      | sed -n 's/^  "\([^"]*\)" => {$/\1/p'
  )

  if (( target_count == 0 )); then
    echo "error: no test targets found in $plist" >&2
    return 1
  fi
}

extract_summary_number() {
  local summary="$1"
  local key="$2"
  printf '%s' "$summary" | plutil -extract "$key" raw -
}

write_normalized_pins() {
  local resolved_path="$1"
  local output_path="$2"
  if command -v jq >/dev/null 2>&1; then
    plutil -convert json -o - "$resolved_path" \
      | jq -r '
          .pins
          | if type != "array" then
              error("Package.resolved has an invalid pins array")
            else
              .[]
            end
          | [
              .identity,
              .kind,
              .location,
              (.state.version // ""),
              (.state.branch // ""),
              .state.revision
            ]
          | if all(.[]; type == "string" and (test("[\\t\\n]") | not)) then
              @tsv
            else
              error("dependency pin contains an unsupported value")
            end
        ' \
      | LC_ALL=C sort > "$output_path"
    return
  fi

  local index=0
  local identity
  local kind
  local location
  local version
  local branch
  local pin_count
  local revision
  : > "$output_path"
  pin_count="$(plutil -extract pins raw -expect array "$resolved_path")"
  if ! [[ "$pin_count" =~ ^[0-9]+$ ]]; then
    echo "error: Package.resolved has an invalid pins array" >&2
    return 1
  fi
  while (( index < pin_count )); do
    identity="$(plutil -extract "pins.$index.identity" raw -expect string \
      "$resolved_path")"
    kind="$(plutil -extract "pins.$index.kind" raw -expect string \
      "$resolved_path")"
    location="$(plutil -extract "pins.$index.location" raw -expect string \
      "$resolved_path")"
    version="$(plutil -extract "pins.$index.state.version" raw -expect string \
      "$resolved_path" 2>/dev/null || true)"
    branch="$(plutil -extract "pins.$index.state.branch" raw -expect string \
      "$resolved_path" 2>/dev/null || true)"
    revision="$(plutil -extract "pins.$index.state.revision" raw -expect string \
      "$resolved_path")"
    if [[ "$identity$kind$location$version$branch$revision" == *$'\t'* \
        || "$identity$kind$location$version$branch$revision" == *$'\n'* ]]; then
      echo "error: dependency pin contains an unsupported control character" >&2
      return 1
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$identity" "$kind" "$location" "$version" "$branch" "$revision" \
      >> "$output_path"
    index=$((index + 1))
  done
  LC_ALL=C sort -o "$output_path" "$output_path"
}

write_build_input_state() {
  local repository_root="$1"
  local scratch_root="$2"
  local work_tree="$3"
  local normalized_manifest="$4"
  local base_object_directory
  local index_path
  local input_object
  local input_path
  local object_directory
  local state_tree

  if ! git -C "$repository_root" rev-parse --verify HEAD >/dev/null 2>&1; then
    echo "error: build input fingerprint requires a committed Git baseline" >&2
    return 1
  fi

  base_object_directory="$(git -C "$repository_root" rev-parse --git-path objects)"
  index_path="$scratch_root/build-input-index.$$"
  object_directory="$(mktemp -d "$scratch_root/build-input-objects.XXXXXX")"
  if ! env \
      GIT_INDEX_FILE="$index_path" \
      GIT_OBJECT_DIRECTORY="$object_directory" \
      GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_object_directory" \
      git -C "$repository_root" read-tree HEAD; then
    rm -rf -- "$object_directory"
    return 1
  fi
  if ! env \
      GIT_INDEX_FILE="$index_path" \
      GIT_OBJECT_DIRECTORY="$object_directory" \
      GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_object_directory" \
      GIT_WORK_TREE="$work_tree" \
      git -C "$repository_root" add -A -f \
        -- Sources Tests Package.resolved; then
    rm -f -- "$index_path"
    rm -rf -- "$object_directory"
    return 1
  fi
  if ! state_tree="$(env \
      GIT_INDEX_FILE="$index_path" \
      GIT_OBJECT_DIRECTORY="$object_directory" \
      GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_object_directory" \
      git -C "$repository_root" write-tree)"; then
    rm -f -- "$index_path"
    rm -rf -- "$object_directory"
    return 1
  fi
  if ! input_object="$(env \
      GIT_OBJECT_DIRECTORY="$object_directory" \
      GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_object_directory" \
      git -C "$repository_root" hash-object -w --no-filters \
        "$normalized_manifest")"; then
    rm -f -- "$index_path"
    rm -rf -- "$object_directory"
    return 1
  fi
  printf 'path=Package.swift\0object=%s\0' "$input_object"
  for input_path in Sources Tests Package.resolved; do
    if input_object="$(env \
        GIT_OBJECT_DIRECTORY="$object_directory" \
        GIT_ALTERNATE_OBJECT_DIRECTORIES="$base_object_directory" \
        git -C "$repository_root" rev-parse "$state_tree:$input_path" \
          2>/dev/null)"; then
      printf 'path=%s\0object=%s\0' "$input_path" "$input_object"
    else
      printf 'path=%s\0missing\0' "$input_path"
    fi
  done
  rm -f -- "$index_path"
  rm -rf -- "$object_directory"
}

compute_build_fingerprint() {
  local work_tree="$1"
  local normalized_manifest="$2"
  local additional_build_argument
  {
    printf 'traits=%s\n' "$TRAITS"
    printf 'scheme=%s\n' "$SCHEME"
    printf 'destination=%s\n' "$DESTINATION"
    printf 'manifest-toolchain=%s\n' "$XCODE_TOOLCHAIN_IDENTIFIER"
    printf 'swift-toolchain=%s\n' "$TOOLCHAIN_IDENTIFIER"
    printf 'xcodebuild-path=%s\n' "$(command -v xcodebuild)"
    printf 'swiftc-path=%s\n' "$PINNED_SWIFTC"
    printf 'developer-directory=%s\n' "${DEVELOPER_DIR:-}"
    xcodebuild -version
    xcrun --toolchain "$TOOLCHAIN_IDENTIFIER" swiftc -version
    printf 'fdb-include=%s\n' "${FDB_CLIENT_INCLUDE_DIRECTORY:-}"
    printf 'fdb-library=%s\n' "${FDB_CLIENT_LIBRARY_DIRECTORY:-}"
    if [[ -n "${FDB_CLUSTER_FILE:-}" ]]; then
      printf 'fdb-build-settings-enabled=true\n'
    else
      printf 'fdb-build-settings-enabled=false\n'
    fi
    printf 'additional-build-argument-count=%d\0' \
      "${#ADDITIONAL_XCODEBUILD_ARGUMENTS[@]}"
    if (( ${#ADDITIONAL_XCODEBUILD_ARGUMENTS[@]} > 0 )); then
      for additional_build_argument in \
          "${ADDITIONAL_XCODEBUILD_ARGUMENTS[@]}"; do
        printf 'additional-build-argument\0%s\0' "$additional_build_argument"
      done
    fi
    write_build_input_state \
      "$ROOT_DIR" \
      "$XCODE_HARNESS_WORK_ROOT" \
      "$work_tree" \
      "$normalized_manifest"
  } | shasum -a 256 | awk '{print $1}'
}

for command in awk cmp env git grep mv rmdir shasum swift xcodebuild xcrun plutil perl rsync tee; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "error: required command not found: $command" >&2
    exit 1
  fi
done
if (( EXPECTED_TARGET_COUNT_SIZE > 0 )) \
    && ! command -v jq >/dev/null 2>&1; then
  echo "error: jq is required for target-level test counts" >&2
  exit 1
fi

PINNED_SWIFTC="$(xcrun --toolchain "$TOOLCHAIN_IDENTIFIER" --find swiftc)"

traits_literal="$(trait_literal "$TRAITS")"
if [[ -n "$REUSE_WORK_ROOT" ]]; then
  temporary_root="${TMPDIR:-/tmp}"
  temporary_root="${temporary_root%/}"
  expected_prefix="$temporary_root/database-framework-xcode-test."
  if [[ "$REUSE_WORK_ROOT" != "$expected_prefix"* \
      || ! -d "$REUSE_WORK_ROOT/source" \
      || ! -d "$REUSE_WORK_ROOT/DerivedData" ]]; then
    echo "error: invalid reusable harness work root: $REUSE_WORK_ROOT" >&2
    exit 2
  fi
  if [[ ! -f "$REUSE_WORK_ROOT/.reusable-work-root" ]]; then
    echo "error: work root was not created for reuse: $REUSE_WORK_ROOT" >&2
    exit 2
  fi
  XCODE_HARNESS_WORK_ROOT="$REUSE_WORK_ROOT"
else
  temporary_root="${TMPDIR:-/tmp}"
  temporary_root="${temporary_root%/}"
  XCODE_HARNESS_WORK_ROOT="$(
    mktemp -d "$temporary_root/database-framework-xcode-test.XXXXXX"
  )"
fi
source_copy="$XCODE_HARNESS_WORK_ROOT/source"
derived_data="$XCODE_HARNESS_WORK_ROOT/DerivedData"
source_packages="$XCODE_HARNESS_WORK_ROOT/SourcePackages"
mkdir -p "$source_copy" "$derived_data" "$source_packages" "$RESULT_DIRECTORY"

HARNESS_LOCK_DIRECTORY="$XCODE_HARNESS_WORK_ROOT/.harness-lock"
if ! mkdir "$HARNESS_LOCK_DIRECTORY" 2>/dev/null; then
  lock_owner=""
  if [[ -f "$HARNESS_LOCK_DIRECTORY/owner-pid" ]]; then
    lock_owner="$(<"$HARNESS_LOCK_DIRECTORY/owner-pid")"
  fi
  if [[ "$lock_owner" =~ ^[1-9][0-9]*$ ]] \
      && ! kill -0 "$lock_owner" 2>/dev/null; then
    rm -f -- "$HARNESS_LOCK_DIRECTORY/owner-pid"
    rmdir "$HARNESS_LOCK_DIRECTORY" 2>/dev/null || true
  fi
  if ! mkdir "$HARNESS_LOCK_DIRECTORY" 2>/dev/null; then
    echo "error: harness work root is already in use: $XCODE_HARNESS_WORK_ROOT" >&2
    exit 2
  fi
fi
printf '%s\n' "$$" > "$HARNESS_LOCK_DIRECTORY/owner-pid"
HARNESS_LOCK_OWNED=true
if [[ "$PRESERVE_WORK_ROOT" == true ]]; then
  printf 'database-framework-xcode-test-work-root-v1\n' \
    > "$XCODE_HARNESS_WORK_ROOT/.reusable-work-root"
fi

normalized_package="$(mktemp "$XCODE_HARNESS_WORK_ROOT/Package.swift.XXXXXX")"
cp "$ROOT_DIR/Package.swift" "$normalized_package"
TRAIT_LITERAL="$traits_literal" perl -0pi -e '
  my $count = s/\.default\(enabledTraits:\s*\[[^\]]*\]\)/.default(enabledTraits: $ENV{TRAIT_LITERAL})/s;
  die "expected at most one default trait declaration\n" if $count > 1;
  if ($count == 0) {
    my $insertions = s/(\n    traits: \[\n)/$1        .default(enabledTraits: $ENV{TRAIT_LITERAL}),\n/s;
    die "package trait list was not found\n" unless $insertions == 1;
  }
' "$normalized_package"

has_local_dependencies=false
if grep -En '\.package\(path:' "$normalized_package" >/dev/null; then
  has_local_dependencies=true
  if [[ "${DATABASE_FRAMEWORK_ALLOW_LOCAL_DEPENDENCIES:-0}" != "1" ]]; then
    echo "error: release verification requires URL dependencies" >&2
    exit 2
  fi
  if grep -En '\.package\(path:' "$normalized_package" \
      | grep -Ev '\.package\(path:[[:space:]]*"\.\./database-kit"' \
      | grep -q .; then
    echo "error: local dependency diagnosis supports only ../database-kit" >&2
    exit 2
  fi
  if [[ "$REUSE_BUILT_TESTS" == true ]]; then
    echo "error: built-test reuse is unavailable with local dependencies" >&2
    exit 2
  fi
fi

locked_pins="$XCODE_HARNESS_WORK_ROOT/locked-pins.tsv"
resolved_pins="$XCODE_HARNESS_WORK_ROOT/resolved-pins.tsv"

build_fingerprint="$(compute_build_fingerprint "$ROOT_DIR" "$normalized_package")"
build_fingerprint_path="$XCODE_HARNESS_WORK_ROOT/build-input-v2.sha256"
reuse_compiled_tests=false
if [[ "$REUSE_BUILT_TESTS" == true ]]; then
  if ! git -C "$ROOT_DIR" rev-parse --verify HEAD >/dev/null 2>&1; then
    echo "error: built-test reuse requires a committed Git baseline" >&2
    exit 2
  fi
  if [[ ! -f "$ROOT_DIR/Package.resolved" ]]; then
    echo "error: built-test reuse requires a repository Package.resolved" >&2
    exit 2
  fi
  if [[ ! -f "$build_fingerprint_path" ]]; then
    echo "error: preserved work root has no successful build fingerprint" >&2
    exit 2
  fi
  recorded_fingerprint="$(<"$build_fingerprint_path")"
  if [[ "$recorded_fingerprint" != "$build_fingerprint" ]]; then
    echo "error: preserved build inputs changed; build-for-testing is required" >&2
    echo "recorded: $recorded_fingerprint" >&2
    echo "current:  $build_fingerprint" >&2
    exit 2
  fi
  preserved_source_fingerprint="$(
    compute_build_fingerprint "$source_copy" "$source_copy/Package.swift"
  )"
  if [[ "$preserved_source_fingerprint" != "$recorded_fingerprint" ]]; then
    echo "error: preserved source no longer matches its successful build" >&2
    exit 2
  fi
  reuse_compiled_tests=true
fi

if [[ "$reuse_compiled_tests" == false ]]; then
  rm -f -- "$build_fingerprint_path"
  rsync_arguments=(
    -a
    --checksum
    --delete
    --exclude '.git'
    --exclude '.build'
    --exclude '.swiftpm'
    --exclude '/Benchmarks'
    --exclude '.fdb-test'
    --exclude '.test-results'
    --exclude '*.xcresult'
  )
  if [[ -n "$REUSE_WORK_ROOT" && -f "$source_copy/Package.swift" ]]; then
    if cmp -s "$normalized_package" "$source_copy/Package.swift"; then
      # Keep the already-normalized manifest timestamp so an unchanged trait
      # graph does not invalidate every SwiftPM target on each focused rerun.
      rsync_arguments+=(--exclude '/Package.swift')
    else
      # SwiftPM/Xcode can retain dependency-trait activation from the previous
      # normalized manifest. A different trait graph must never reuse those
      # products because the dependent package may expose a different API.
      rm -rf -- "$derived_data"
      mkdir -p "$derived_data"
    fi
    if [[ -f "$ROOT_DIR/Package.resolved" \
        && -f "$source_copy/Package.resolved" ]] \
        && cmp -s "$ROOT_DIR/Package.resolved" "$source_copy/Package.resolved"; then
      # Preserve the lock-file timestamp only after exact content comparison.
      rsync_arguments+=(--exclude '/Package.resolved')
    fi
  fi
  rsync "${rsync_arguments[@]}" "$ROOT_DIR/" "$source_copy/"
  if ! cmp -s "$normalized_package" "$source_copy/Package.swift"; then
    rsync -a "$normalized_package" "$source_copy/Package.swift"
  fi

  synchronized_build_fingerprint="$(
    compute_build_fingerprint "$source_copy" "$source_copy/Package.swift"
  )"
  if [[ "$synchronized_build_fingerprint" != "$build_fingerprint" ]]; then
    echo "error: synchronized source does not match the recorded build input" >&2
    exit 1
  fi

  if [[ "$has_local_dependencies" == true ]]; then
    database_kit_source="$ROOT_DIR/../database-kit"
    database_kit_copy="$XCODE_HARNESS_WORK_ROOT/database-kit"
    if [[ ! -f "$database_kit_source/Package.swift" ]]; then
      echo "error: local database-kit source is unavailable" >&2
      exit 2
    fi
    rsync -a --checksum --delete \
      --exclude '.git' \
      --exclude '.build' \
      --exclude '.swiftpm' \
      --exclude '*.xcresult' \
      "$database_kit_source/" "$database_kit_copy/"
  fi
fi
rm -f -- "$normalized_package"

if [[ "$reuse_compiled_tests" == true ]]; then
  if [[ ! -s "$resolved_pins" ]]; then
    echo "error: preserved work root has no validated dependency pins" >&2
    exit 2
  fi
  echo "Reusing the dependency graph validated by the matching build."
else
  if [[ -f "$ROOT_DIR/Package.resolved" ]]; then
    write_normalized_pins "$ROOT_DIR/Package.resolved" "$locked_pins"
  fi

  if [[ -f "$ROOT_DIR/Package.resolved" ]]; then
    echo "Using the repository's pinned SwiftPM dependency graph."
  else
    (
      cd "$source_copy"
      timeout_command "$RESOLVE_TIMEOUT_SECONDS" \
        xcrun --toolchain "$TOOLCHAIN_IDENTIFIER" swift package resolve
    )
  fi
  write_normalized_pins "$source_copy/Package.resolved" "$resolved_pins"
  if [[ -f "$locked_pins" ]]; then
    while IFS= read -r locked_pin; do
      if ! grep -Fqx "$locked_pin" "$resolved_pins"; then
        echo "error: trait resolution changed an existing dependency pin" >&2
        diff -u "$locked_pins" "$resolved_pins" || true
        exit 1
      fi
    done < "$locked_pins"
  fi
fi
echo "Resolved dependency pins:"
awk -F '\t' '{ selected = ($4 == "" ? $6 : $4); print "  " $1 " " selected " " $6 }' \
  "$resolved_pins"

run_identifier="$(date +%Y%m%d-%H%M%S)-$$"
build_result="$RESULT_DIRECTORY/Build-$run_identifier.xcresult"
test_result="$RESULT_DIRECTORY/Test-$run_identifier.xcresult"
build_log="$RESULT_DIRECTORY/Build-$run_identifier.log"
test_log="$RESULT_DIRECTORY/Test-$run_identifier.log"

reject_internal_tool_errors() {
  local log_path="$1"
  if grep -En \
      'Internal Error:|LLVM Profile Error:|warning: input verification failed' \
      "$log_path" >&2; then
    echo "error: internal tool failure detected in $log_path" >&2
    return 1
  fi
}

build_arguments=(
  build-for-testing
  -scheme "$SCHEME"
  -destination "$DESTINATION"
  -derivedDataPath "$derived_data"
  -clonedSourcePackagesDirPath "$source_packages"
  -disablePackageRepositoryCache
  -resultBundlePath "$build_result"
  -enableCodeCoverage NO
  -onlyUsePackageVersionsFromResolvedFile
  -skipPackageUpdates
  # Macro revisions are pinned and checked above; CI cannot present Xcode's
  # interactive macro approval UI.
  -skipMacroValidation
)
if [[ -n "${FDB_CLUSTER_FILE:-}" ]]; then
  fdb_include_directory="${FDB_CLIENT_INCLUDE_DIRECTORY:-/usr/local/include}"
  fdb_library_directory="${FDB_CLIENT_LIBRARY_DIRECTORY:-/usr/local/lib}"
  if [[ ! -f "$fdb_include_directory/foundationdb/fdb_c.h" ]]; then
    echo "error: FoundationDB C header not found under $fdb_include_directory" >&2
    exit 1
  fi
  if [[ ! -f "$fdb_library_directory/libfdb_c.dylib" ]]; then
    echo "error: FoundationDB client library not found under $fdb_library_directory" >&2
    exit 1
  fi
  build_arguments+=(
    "HEADER_SEARCH_PATHS=\$(inherited) $fdb_include_directory"
    "LIBRARY_SEARCH_PATHS=\$(inherited) $fdb_library_directory"
  )
fi
if (( ${#ADDITIONAL_XCODEBUILD_ARGUMENTS[@]} > 0 )); then
  build_arguments+=("${ADDITIONAL_XCODEBUILD_ARGUMENTS[@]}")
fi

echo "Traits: $TRAITS"
echo "Temporary source: $source_copy"
if [[ "$reuse_compiled_tests" == true ]]; then
  echo "Reusing compiled tests with matching input fingerprint: $build_fingerprint"
else
  echo "Build result: $build_result"
  echo "Build log: $build_log"
  set +e
  (
    cd "$source_copy"
    # Xcode 27 evaluates package manifests with its bundled Swift 6.4
    # toolchain. SWIFT_EXEC keeps every Swift target on the pinned snapshot.
    timeout_command "$BUILD_TIMEOUT_SECONDS" env \
      TOOLCHAINS="$XCODE_TOOLCHAIN_IDENTIFIER" \
      xcodebuild "${build_arguments[@]}" \
      SWIFT_EXEC="$PINNED_SWIFTC" \
      2>&1 | tee "$build_log"
  )
  build_status=$?
  set -e
  reject_internal_tool_errors "$build_log"
  if ! grep -F "SWIFT_EXEC = $PINNED_SWIFTC" "$build_log" >/dev/null; then
    echo "error: Xcode did not record the pinned Swift compiler" >&2
    exit 1
  fi
  if (( build_status != 0 )); then
    echo "error: xcodebuild build-for-testing exited with status $build_status" >&2
    exit "$build_status"
  fi
  built_source_fingerprint="$(
    compute_build_fingerprint "$source_copy" "$source_copy/Package.swift"
  )"
  if [[ "$built_source_fingerprint" != "$build_fingerprint" ]]; then
    echo "error: build source changed before provenance could be recorded" >&2
    exit 1
  fi
  build_fingerprint_temporary_path="$build_fingerprint_path.tmp.$$"
  printf '%s\n' "$build_fingerprint" > "$build_fingerprint_temporary_path"
  mv -f -- "$build_fingerprint_temporary_path" "$build_fingerprint_path"
fi

xctestrun_paths="$(
  find "$derived_data/Build/Products" -maxdepth 1 \
    -type f -name '*.xctestrun' ! -name '.environment-*' -print
)"
xctestrun_count="$(printf '%s\n' "$xctestrun_paths" | sed '/^$/d' | wc -l | tr -d ' ')"
if [[ "$xctestrun_count" != "1" ]]; then
  echo "error: expected one xctestrun file, found $xctestrun_count" >&2
  printf '%s\n' "$xctestrun_paths" >&2
  exit 1
fi
source_xctestrun="$xctestrun_paths"
injected_xctestrun="$(dirname "$source_xctestrun")/.environment-$run_identifier.xctestrun"
cp "$source_xctestrun" "$injected_xctestrun"
inject_environment "$injected_xctestrun"

test_arguments=(
  test-without-building
  -xctestrun "$injected_xctestrun"
  -destination "$DESTINATION"
  -resultBundlePath "$test_result"
  -enableCodeCoverage NO
)
if [[ -n "${FDB_CLUSTER_FILE:-}" \
    || -n "${POSTGRES_TEST_UNIX_SOCKET:-}" \
    || -n "${POSTGRES_TEST_HOST:-}" ]]; then
  # Scenario actors serialize access only within one test process. Xcode test
  # bundle parallelism would create multiple coordinators against the same
  # isolated service and invalidate transaction timeout/isolation evidence.
  # Compilation and Swift Testing within each bundle remain parallel.
  test_arguments+=(
    -parallel-testing-enabled NO
    -maximum-parallel-testing-workers 1
  )
fi
if (( ${#ONLY_TESTING[@]} > 0 )); then
  for identifier in "${ONLY_TESTING[@]}"; do
    test_arguments+=("-only-testing:$identifier")
  done
fi
if (( ${#SKIP_TESTING[@]} > 0 )); then
  for identifier in "${SKIP_TESTING[@]}"; do
    test_arguments+=("-skip-testing:$identifier")
  done
fi
if (( ${#ADDITIONAL_XCODEBUILD_ARGUMENTS[@]} > 0 )); then
  test_arguments+=("${ADDITIONAL_XCODEBUILD_ARGUMENTS[@]}")
fi

echo "Test result: $test_result"
echo "Test log: $test_log"
set +e
timeout_command "$TEST_TIMEOUT_SECONDS" env \
  TOOLCHAINS="$XCODE_TOOLCHAIN_IDENTIFIER" \
  xcodebuild "${test_arguments[@]}" \
  2>&1 | tee "$test_log"
test_status=$?
set -e
reject_internal_tool_errors "$test_log"

if [[ ! -d "$test_result" ]]; then
  echo "error: xcodebuild did not produce a test result bundle" >&2
  exit "$test_status"
fi

summary="$(
  xcrun xcresulttool get test-results summary \
    --path "$test_result" --format json
)"
printf '%s\n' "$summary"

total_count="$(extract_summary_number "$summary" totalTestCount)"
passed_count="$(extract_summary_number "$summary" passedTests)"
failed_count="$(extract_summary_number "$summary" failedTests)"
skipped_count="$(extract_summary_number "$summary" skippedTests)"
expected_failure_count="$(extract_summary_number "$summary" expectedFailures)"
runtime_warning_count="$(extract_summary_number "$summary" runtimeWarnings)"

if ! [[ "$total_count" =~ ^[0-9]+$ ]] || (( total_count == 0 )); then
  echo "error: xcodebuild executed zero tests" >&2
  exit 1
fi
if (( failed_count != 0 )); then
  echo "error: $failed_count tests failed" >&2
  exit 1
fi
if [[ -n "$EXPECTED_TEST_COUNT" && "$total_count" != "$EXPECTED_TEST_COUNT" ]]; then
  echo "error: expected $EXPECTED_TEST_COUNT tests, executed $total_count" >&2
  exit 1
fi
if (( EXPECTED_TARGET_COUNT_SIZE > 0 )); then
  test_tree="$(
    xcrun xcresulttool get test-results tests \
      --path "$test_result" --compact
  )"
  expected_target_total=0
  for expected_target_count in "${EXPECTED_TARGET_COUNTS[@]}"; do
    expected_target="${expected_target_count%%=*}"
    expected_count="${expected_target_count#*=}"
    bundle_count="$(
      printf '%s' "$test_tree" | jq --arg target "$expected_target" \
        '[.. | objects | select(.nodeType == "Unit test bundle" and .name == $target)] | length'
    )"
    if [[ "$bundle_count" != "1" ]]; then
      echo "error: expected one test bundle named $expected_target, found $bundle_count" >&2
      exit 1
    fi
    actual_count="$(
      printf '%s' "$test_tree" | jq --arg target "$expected_target" \
        '[.. | objects | select(.nodeType == "Unit test bundle" and .name == $target) | .. | objects | select(.nodeType == "Test Case")] | length'
    )"
    if [[ "$actual_count" != "$expected_count" ]]; then
      echo "error: expected $expected_count tests in $expected_target, executed $actual_count" >&2
      exit 1
    fi
    expected_target_total=$((expected_target_total + expected_count))
  done
  if (( expected_target_total != total_count )); then
    echo "error: target count contract covers $expected_target_total tests, executed $total_count" >&2
    exit 1
  fi
fi
if [[ "$REQUIRE_ZERO_SKIPS" == true && "$skipped_count" != "0" ]]; then
  echo "error: expected zero skipped tests, observed $skipped_count" >&2
  exit 1
fi
if [[ "$REQUIRE_ZERO_EXPECTED_FAILURES" == true && "$expected_failure_count" != "0" ]]; then
  echo "error: expected zero expected failures, observed $expected_failure_count" >&2
  exit 1
fi
if [[ "$REQUIRE_ZERO_RUNTIME_WARNINGS" == true && "$runtime_warning_count" != "0" ]]; then
  echo "error: expected zero runtime warnings, observed $runtime_warning_count" >&2
  exit 1
fi
if (( test_status != 0 )); then
  echo "error: xcodebuild exited with status $test_status" >&2
  exit "$test_status"
fi

echo "Passed: $passed_count"
echo "Failed: $failed_count"
echo "Skipped: $skipped_count"
echo "Expected failures: $expected_failure_count"
echo "Runtime warnings: $runtime_warning_count"
echo "Result bundle: $test_result"
