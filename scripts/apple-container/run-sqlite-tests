#!/usr/bin/env bash
set -euo pipefail

TRAITS="${SQLITE_TEST_TRAITS:?SQLITE_TEST_TRAITS is required}"
EXPECTED_TEST_COUNT="${SQLITE_TEST_EXPECTED_COUNT:?SQLITE_TEST_EXPECTED_COUNT is required}"
RESULT_DIRECTORY="${SQLITE_TEST_RESULT_DIRECTORY:-/results}"
TIMEOUT_SECONDS="${SQLITE_TEST_TIMEOUT_SECONDS:-1800}"
SQLITE_VERSION="${SQLITE_VERSION:?SQLITE_VERSION is required}"
SQLITE_AMALGAMATION_SHA256="${SQLITE_AMALGAMATION_SHA256:?SQLITE_AMALGAMATION_SHA256 is required}"
SWIFT_SNAPSHOT="${SWIFT_LINUX_SNAPSHOT:?SWIFT_LINUX_SNAPSHOT is required}"
SWIFT_COMPILER_COMMIT="${SWIFT_LINUX_COMPILER_COMMIT:?SWIFT_LINUX_COMPILER_COMMIT is required}"
SWIFT_BASE_VERSION="${SWIFT_LINUX_BASE_VERSION:?SWIFT_LINUX_BASE_VERSION is required}"
SWIFT_BASE_IMAGE_DIGEST="${SWIFT_LINUX_BASE_IMAGE_DIGEST:?SWIFT_LINUX_BASE_IMAGE_DIGEST is required}"
SWIFT_BASE_IMAGE_CREATED="${SWIFT_LINUX_BASE_IMAGE_CREATED:?SWIFT_LINUX_BASE_IMAGE_CREATED is required}"
SWIFT_TOOLCHAIN_SHA256="${SWIFT_LINUX_TOOLCHAIN_SHA256:?SWIFT_LINUX_TOOLCHAIN_SHA256 is required}"
TEST_IMAGE_REFERENCE="${SQLITE_TEST_IMAGE_REFERENCE:?SQLITE_TEST_IMAGE_REFERENCE is required}"
TEST_IMAGE_FINGERPRINT="${SQLITE_TEST_IMAGE_FINGERPRINT:?SQLITE_TEST_IMAGE_FINGERPRINT is required}"
RUNTIME_CACHE_IDENTITY="${SQLITE_TEST_RUNTIME_CACHE_IDENTITY:?SQLITE_TEST_RUNTIME_CACHE_IDENTITY is required}"
IMAGE_IDENTITY_PATH=/usr/local/share/database-framework/sqlite-test-image.env
SWIFT_TOOLCHAIN_ROOT=/opt/swift-toolchain/usr

export PATH="$SWIFT_TOOLCHAIN_ROOT/bin:$PATH"
export LD_LIBRARY_PATH="$SWIFT_TOOLCHAIN_ROOT/lib/swift/linux:/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

if ! [[ "$EXPECTED_TEST_COUNT" =~ ^[1-9][0-9]*$ ]]; then
  echo "error: SQLITE_TEST_EXPECTED_COUNT must be a positive integer" >&2
  exit 2
fi
if ! [[ "$TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
  echo "error: SQLITE_TEST_TIMEOUT_SECONDS must be a positive integer" >&2
  exit 2
fi

if [[ ! -f "$IMAGE_IDENTITY_PATH" ]]; then
  echo "error: SQLite test image identity is missing: $IMAGE_IDENTITY_PATH" >&2
  exit 1
fi
if [[ ! -x "$SWIFT_TOOLCHAIN_ROOT/bin/swift" ]]; then
  echo "error: mounted Linux Swift toolchain is missing" >&2
  exit 1
fi

# shellcheck source=/etc/os-release
source /etc/os-release
if [[ "${ID:-}" != "ubuntu" || "${VERSION_ID:-}" != "24.04" ]]; then
  echo "error: container OS does not match $SWIFT_BASE_VERSION" >&2
  exit 1
fi
for expected_identity in \
    'format=database-framework-sqlite-test-image-v1' \
    "swift_snapshot=$SWIFT_SNAPSHOT" \
    "swift_compiler_commit=$SWIFT_COMPILER_COMMIT" \
    "swift_toolchain_sha256=$SWIFT_TOOLCHAIN_SHA256" \
    "sqlite_version=$SQLITE_VERSION" \
    "sqlite_amalgamation_sha256=$SQLITE_AMALGAMATION_SHA256"; do
  if ! grep -Fxq "$expected_identity" "$IMAGE_IDENTITY_PATH"; then
    echo "error: SQLite test image identity mismatch: $expected_identity" >&2
    exit 1
  fi
done

mkdir -p "$RESULT_DIRECTORY"
run_identifier="$(date +%Y%m%d-%H%M%S)-$$"
test_log="$RESULT_DIRECTORY/SQLiteLinux-$run_identifier.log"
xunit_output_path="$RESULT_DIRECTORY/SQLiteLinux-$run_identifier.xml"
# SwiftPM writes Swift Testing results beside the requested XCTest report by
# inserting this suffix before the extension.
xunit_path="${xunit_output_path%.xml}-swift-testing.xml"
environment_path="$RESULT_DIRECTORY/SQLiteLinux-$run_identifier.environment"

trap 'exit 130' INT
trap 'exit 143' TERM

compiler_version="$(swift --version)"
if [[ "$compiler_version" != *"Swift version 6.4-dev"* \
    || "$compiler_version" != *"Swift $SWIFT_COMPILER_COMMIT"* ]]; then
  echo "error: Linux Swift compiler does not match $SWIFT_SNAPSHOT" >&2
  echo "$compiler_version" >&2
  exit 1
fi

for command in pkg-config sqlite3 swift xmllint; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "error: required command not found in the SQLite test image: $command" >&2
    exit 1
  fi
done
if [[ "$(sqlite3 ':memory:' 'select sqlite_version();')" != "$SQLITE_VERSION" ]]; then
  echo "error: SQLite runtime version does not match the pinned release" >&2
  exit 1
fi

{
  swift --version
  printf 'swift-snapshot=%s\n' "$SWIFT_SNAPSHOT"
  printf 'swift-compiler-commit=%s\n' "$SWIFT_COMPILER_COMMIT"
  printf 'swift-toolchain-sha256=%s\n' "$SWIFT_TOOLCHAIN_SHA256"
  printf 'linux-base-version=%s\n' "$SWIFT_BASE_VERSION"
  printf 'linux-base-image-digest=%s\n' "$SWIFT_BASE_IMAGE_DIGEST"
  printf 'linux-base-image-created=%s\n' "$SWIFT_BASE_IMAGE_CREATED"
  printf 'linux-os-release=%s\n' "${PRETTY_NAME:-unknown}"
  printf 'sqlite-version=%s\n' "$(sqlite3 ':memory:' 'select sqlite_version();')"
  printf 'sqlite-pkg-config-version=%s\n' "$(pkg-config --modversion sqlite3)"
  printf 'sqlite-amalgamation-sha256=%s\n' "$SQLITE_AMALGAMATION_SHA256"
  printf 'test-image-reference=%s\n' "$TEST_IMAGE_REFERENCE"
  printf 'test-image-fingerprint=%s\n' "$TEST_IMAGE_FINGERPRINT"
  printf 'runtime-cache-identity=%s\n' "$RUNTIME_CACHE_IDENTITY"
  printf 'traits=%s\n' "$TRAITS"
  printf 'target=%s\n' "$(uname -m)-unknown-linux-gnu"
} | tee "$environment_path"

set +e
set -o pipefail
perl -e 'alarm shift; exec @ARGV' "$TIMEOUT_SECONDS" \
  swift test \
    -debug-info-format none \
    --disable-index-store \
    --disable-default-traits \
    --traits "$TRAITS" \
    --filter SQLiteTests \
    --xunit-output "$xunit_output_path" \
    --only-use-versions-from-resolved-file \
    2>&1 | tee "$test_log"
test_status=$?
set -e

if (( test_status != 0 )); then
  echo "error: Swift SQLite tests exited with status $test_status" >&2
  exit "$test_status"
fi
if [[ ! -s "$xunit_path" ]]; then
  echo "error: Swift Testing did not produce $xunit_path" >&2
  exit 1
fi

test_count="$({
  xmllint --xpath 'sum(/testsuites/testsuite/@tests | /testsuite/@tests)' "$xunit_path"
} 2>/dev/null)"
failure_count="$({
  xmllint --xpath 'sum(/testsuites/testsuite/@failures | /testsuite/@failures)' "$xunit_path"
} 2>/dev/null)"
error_count="$({
  xmllint --xpath 'sum(/testsuites/testsuite/@errors | /testsuite/@errors)' "$xunit_path"
} 2>/dev/null)"
skipped_count="$({
  xmllint --xpath 'sum(/testsuites/testsuite/@skipped | /testsuite/@skipped)' "$xunit_path"
} 2>/dev/null)"
compiler_warning_count="$(
  perl -pe 's/\e\[[0-9;]*[[:alpha:]]//g' "$test_log" \
    | grep -Ec ':[0-9]+:[0-9]+: warning:' \
    || true
)"

printf 'SQLite Linux results: tests=%s failures=%s errors=%s skipped=%s compiler-warnings=%s\n' \
  "$test_count" "$failure_count" "$error_count" "$skipped_count" \
  "$compiler_warning_count"

if [[ "$test_count" != "$EXPECTED_TEST_COUNT" ]]; then
  echo "error: expected $EXPECTED_TEST_COUNT SQLite tests, found $test_count" >&2
  exit 1
fi
if [[ "$failure_count" != "0" || "$error_count" != "0" || "$skipped_count" != "0" ]]; then
  echo "error: SQLite Linux verification requires zero failures, errors, and skips" >&2
  exit 1
fi
if [[ "$compiler_warning_count" != "0" ]]; then
  echo "error: SQLite Linux verification requires zero compiler warnings" >&2
  exit 1
fi
