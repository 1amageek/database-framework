### D07 success block d07-deferred-repair
--setup
CREATE TABLE parent(id integer PRIMARY KEY);
CREATE TABLE child(pid integer REFERENCES parent(id) DEFERRABLE INITIALLY DEFERRED);
--query
INSERT INTO child VALUES (1);
INSERT INTO parent VALUES (1);
SELECT count(*) AS children FROM child;

### D07 failure block d07-deferred-final-failure
--setup
CREATE TABLE parent(id integer PRIMARY KEY);
CREATE TABLE child(pid integer REFERENCES parent(id) DEFERRABLE INITIALLY DEFERRED);
--query
INSERT INTO child VALUES (1);
--post
SELECT count(*) AS children FROM child

### D07 failure block d07-set-constraints-immediate
--setup
CREATE TABLE parent(id integer PRIMARY KEY);
CREATE TABLE child(pid integer REFERENCES parent(id) DEFERRABLE INITIALLY DEFERRED);
--query
INSERT INTO child VALUES (1);
SET CONSTRAINTS ALL IMMEDIATE;

### D08 success block d08-identity-serial-generated
--setup
CREATE TABLE items(id integer GENERATED BY DEFAULT AS IDENTITY, serial_id serial, price numeric, tax numeric GENERATED ALWAYS AS (price * 0.1) STORED);
--query
INSERT INTO items(price) VALUES (10), (20);
INSERT INTO items(id, price) VALUES (100, 30);
SELECT id, serial_id, price, tax FROM items ORDER BY serial_id;

### D08 failure block d08-identity-always-override
--setup
CREATE TABLE items(id integer GENERATED ALWAYS AS IDENTITY, v integer);
--query
INSERT INTO items(id, v) VALUES (5, 1);

### D08 boundary block d08-overriding-system-value
--setup
CREATE TABLE items(id integer GENERATED ALWAYS AS IDENTITY, v integer);
--query
INSERT INTO items(id, v) OVERRIDING SYSTEM VALUE VALUES (5, 1);
INSERT INTO items(v) VALUES (2);
SELECT id, v FROM items ORDER BY v;

### D08 failure block d08-write-generated-column
--setup
CREATE TABLE items(price numeric, tax numeric GENERATED ALWAYS AS (price * 0.1) STORED);
--query
INSERT INTO items VALUES (10, 1);

### D08 failure block d08-volatile-generated-expression
--query
CREATE TABLE items(v integer, r timestamptz GENERATED ALWAYS AS (clock_timestamp()) STORED);

### D09 success block d09-unique-composite-expression-partial-indexes
--setup
CREATE TABLE users(id integer, email text, active boolean);
--query
CREATE UNIQUE INDEX users_email ON users(lower(email));
CREATE INDEX users_active ON users(id) WHERE active;
CREATE UNIQUE INDEX users_pair ON users(id, email);
INSERT INTO users VALUES (1, 'A@x', true), (2, 'b@x', false);
SELECT id FROM users WHERE lower(email) = 'a@x';

### D09 failure block d09-unique-index-build-validates
--setup
CREATE TABLE users(email text);
INSERT INTO users VALUES ('a'), ('a');
--query
CREATE UNIQUE INDEX users_email ON users(email);

### D09 failure block d09-expression-index-conflict
--setup
CREATE TABLE users(email text);
CREATE UNIQUE INDEX users_email ON users(lower(email));
INSERT INTO users VALUES ('A');
--query
INSERT INTO users VALUES ('a');

### D09 boundary block d09-partial-unique-ignores-excluded
--setup
CREATE TABLE users(email text, active boolean);
CREATE UNIQUE INDEX active_email ON users(email) WHERE active;
--query
INSERT INTO users VALUES ('a', false), ('a', false), ('a', true);
DROP INDEX active_email;
SELECT count(*) AS stored FROM users;

### D10 success block d10-view-create-replace
--setup
CREATE TABLE items(id integer, price numeric);
INSERT INTO items VALUES (1, 2), (2, 3);
--query
CREATE VIEW priced AS SELECT id, price FROM items;
CREATE OR REPLACE VIEW priced AS SELECT id, price, price * 2 AS doubled FROM items;
SELECT id, price, doubled FROM priced ORDER BY id;

### D10 failure block d10-replace-drops-column
--setup
CREATE TABLE items(id integer, price numeric);
CREATE VIEW priced AS SELECT id, price FROM items;
--query
CREATE OR REPLACE VIEW priced AS SELECT id FROM items;

### D10 failure block d10-view-mutation-rejected
--setup
CREATE TABLE items(id integer);
CREATE VIEW grouped AS SELECT count(*) AS n FROM items;
--query
INSERT INTO grouped VALUES (1);

### D10 boundary block d10-drop-view
--setup
CREATE TABLE items(id integer);
CREATE VIEW v AS SELECT id FROM items;
--query
DROP VIEW v;
SELECT count(*) AS views FROM information_schema.views WHERE table_name = 'v';

### D11 success block d11-materialized-view-refresh
--setup
CREATE TABLE items(v integer);
INSERT INTO items VALUES (1);
--query
CREATE MATERIALIZED VIEW snapshot AS SELECT sum(v) AS total FROM items;
INSERT INTO items VALUES (2);
SELECT total FROM snapshot;

### D11 boundary block d11-refresh-visible-after
--setup
CREATE TABLE items(v integer);
INSERT INTO items VALUES (1);
CREATE MATERIALIZED VIEW snapshot AS SELECT sum(v) AS total FROM items;
--query
INSERT INTO items VALUES (2);
REFRESH MATERIALIZED VIEW snapshot;
SELECT total FROM snapshot;

### D11 failure block d11-drop-base-with-dependent-matview
--setup
CREATE TABLE items(v integer);
CREATE MATERIALIZED VIEW snapshot AS SELECT v FROM items;
--query
DROP TABLE items;

### D11 boundary block d11-drop-materialized-view
--setup
CREATE TABLE items(v integer);
CREATE MATERIALIZED VIEW snapshot AS SELECT v FROM items;
--query
DROP MATERIALIZED VIEW snapshot;
SELECT count(*) AS remaining FROM items;

### D12 success block d12-sequence-options
--query
CREATE SEQUENCE s START 10 INCREMENT 5 MINVALUE 1 MAXVALUE 20 CYCLE;
SELECT nextval('s') AS a, nextval('s') AS b, nextval('s') AS c, nextval('s') AS d;

### D12 failure block d12-sequence-exhausted
--query
CREATE SEQUENCE s START 1 MAXVALUE 2;
SELECT nextval('s'), nextval('s'), nextval('s');

### D12 boundary block d12-alter-and-drop-sequence
--query
CREATE SEQUENCE s;
ALTER SEQUENCE s RESTART WITH 50 INCREMENT BY -1;
SELECT nextval('s') AS a, nextval('s') AS b;

### D12 failure block d12-invalid-sequence-bounds
--query
CREATE SEQUENCE s MINVALUE 10 MAXVALUE 1;

### D12 failure block d12-consumption-survives-rollback
--setup
CREATE SEQUENCE s;
--query
SELECT nextval('s');
SELECT 1 / 0;
--post
SELECT nextval('s') AS after_rollback

### D07 boundary block d07-set-constraints-deferred-repair
--setup
CREATE TABLE parent(id integer PRIMARY KEY);
CREATE TABLE child(pid integer REFERENCES parent(id) DEFERRABLE INITIALLY IMMEDIATE);
--query
SET CONSTRAINTS ALL DEFERRED;
INSERT INTO child VALUES (1);
INSERT INTO parent VALUES (1);
SELECT count(*) AS children FROM child;
