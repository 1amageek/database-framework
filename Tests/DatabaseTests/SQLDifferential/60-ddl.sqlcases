-- D01-D12 logical schemas, tables, constraints, identities, indexes, views and sequences.

### D01 success block d01-schema-search-path
--query
CREATE SCHEMA app;
CREATE TABLE app.items(v integer);
INSERT INTO app.items VALUES (1);
SET LOCAL search_path TO app;
SELECT v FROM items;

### D01 success block d01-schema-rename-and-drop
--setup
CREATE SCHEMA old_name;
CREATE TABLE old_name.items(v integer);
INSERT INTO old_name.items VALUES (7);
--query
ALTER SCHEMA old_name RENAME TO new_name;
CREATE SCHEMA scratch;
DROP SCHEMA scratch;
SELECT v FROM new_name.items;

### D01 failure block d01-drop-nonempty-schema
--setup
CREATE SCHEMA app;
CREATE TABLE app.items(v integer);
--query
DROP SCHEMA app;
--post
SELECT count(*) AS tables FROM information_schema.tables WHERE table_schema = 'app'

### D01 boundary block d01-drop-schema-cascade
--setup
CREATE SCHEMA app;
CREATE TABLE app.items(v integer);
--query
DROP SCHEMA app CASCADE;
--post
SELECT count(*) AS tables FROM information_schema.tables WHERE table_schema = 'app'

### D02 success block d02-create-if-not-exists-and-as
--setup
CREATE TABLE items(v integer);
INSERT INTO items VALUES (1), (2);
--query
CREATE TABLE IF NOT EXISTS items(other text);
CREATE TABLE copy AS SELECT v * 2 AS doubled FROM items;
SELECT doubled FROM copy ORDER BY doubled;

### D02 boundary block d02-zero-row-ctas-types
--query
CREATE TABLE empty AS SELECT 1::smallint AS s, 'x'::varchar(4) AS t WHERE false;
SELECT column_name, data_type FROM information_schema.columns WHERE table_name = 'empty' ORDER BY ordinal_position;

### D02 failure block d02-duplicate-table
--setup
CREATE TABLE items(v integer);
--query
CREATE TABLE items(v integer);

### D02 success block d02-temporary-table
--query
CREATE TEMPORARY TABLE scratch(v integer);
INSERT INTO scratch VALUES (5);
SELECT v FROM scratch;

### D03 success block d03-alter-columns
--setup
CREATE TABLE items(id integer, label text);
INSERT INTO items VALUES (1, '10'), (2, '20');
--query
ALTER TABLE items ADD COLUMN flag boolean DEFAULT true;
ALTER TABLE items ALTER COLUMN label TYPE integer USING label::integer;
ALTER TABLE items RENAME COLUMN label TO amount;
ALTER TABLE items DROP COLUMN flag;
ALTER TABLE items RENAME TO stock;
SELECT id, amount FROM stock ORDER BY id;

### D03 boundary block d03-default-and-not-null
--setup
CREATE TABLE items(id integer);
INSERT INTO items VALUES (1);
--query
ALTER TABLE items ADD COLUMN qty integer NOT NULL DEFAULT 0;
ALTER TABLE items ALTER COLUMN qty SET DEFAULT 5;
INSERT INTO items(id) VALUES (2);
SELECT id, qty FROM items ORDER BY id;

### D03 failure block d03-type-change-invalid-data
--setup
CREATE TABLE items(label text);
INSERT INTO items VALUES ('abc');
--query
ALTER TABLE items ALTER COLUMN label TYPE integer USING label::integer;
--post
SELECT label FROM items

### D03 failure block d03-set-not-null-with-nulls
--setup
CREATE TABLE items(v integer);
INSERT INTO items VALUES (NULL);
--query
ALTER TABLE items ALTER COLUMN v SET NOT NULL;

### D04 success block d04-drop-if-exists
--setup
CREATE TABLE items(v integer);
--query
DROP TABLE IF EXISTS items;
DROP TABLE IF EXISTS never_created;
SELECT count(*) AS remaining FROM information_schema.tables WHERE table_name = 'items';

### D04 failure block d04-drop-restrict-dependency
--setup
CREATE TABLE parent(id integer PRIMARY KEY);
CREATE TABLE child(parent_id integer REFERENCES parent(id));
--query
DROP TABLE parent RESTRICT;

### D04 boundary block d04-drop-cascade-removes-view
--setup
CREATE TABLE base(v integer);
CREATE VIEW over_base AS SELECT v FROM base;
--query
DROP TABLE base CASCADE;
SELECT count(*) AS views FROM information_schema.views WHERE table_name = 'over_base';

### D05 success block d05-composite-primary-key
--setup
CREATE TABLE pairs(a integer, b integer, label text, PRIMARY KEY (a, b));
--query
INSERT INTO pairs VALUES (1, 1, 'x'), (1, 2, 'y');
SELECT a, b, label FROM pairs ORDER BY a, b;

### D05 failure block d05-composite-key-conflict
--setup
CREATE TABLE pairs(a integer, b integer, PRIMARY KEY (a, b));
INSERT INTO pairs VALUES (1, 1);
--query
INSERT INTO pairs VALUES (1, 1);

### D05 boundary block d05-unique-nulls-not-distinct
--setup
CREATE TABLE distinct_nulls(v integer UNIQUE);
CREATE TABLE same_nulls(v integer UNIQUE NULLS NOT DISTINCT);
--query
INSERT INTO distinct_nulls VALUES (NULL), (NULL);
INSERT INTO same_nulls VALUES (NULL);
SELECT (SELECT count(*) FROM distinct_nulls) AS distinct_count, (SELECT count(*) FROM same_nulls) AS same_count;

### D05 failure block d05-unique-nulls-not-distinct-conflict
--setup
CREATE TABLE same_nulls(v integer UNIQUE NULLS NOT DISTINCT);
INSERT INTO same_nulls VALUES (NULL);
--query
INSERT INTO same_nulls VALUES (NULL);

### D05 boundary block d05-no-primary-key-duplicates
--setup
CREATE TABLE loose(v integer);
--query
INSERT INTO loose VALUES (1), (1);
SELECT v, count(*) AS n FROM loose GROUP BY v;

### D06 success block d06-check-unknown-passes
--setup
CREATE TABLE items(v integer CHECK (v > 0));
--query
INSERT INTO items VALUES (1), (NULL);
SELECT count(*) AS stored FROM items;

### D06 failure block d06-check-violation
--setup
CREATE TABLE items(v integer CHECK (v > 0));
--query
INSERT INTO items VALUES (0);

### D06 success block d06-foreign-key-actions
--setup
CREATE TABLE parent(id integer PRIMARY KEY);
CREATE TABLE cascade_child(pid integer REFERENCES parent(id) ON DELETE CASCADE ON UPDATE CASCADE);
CREATE TABLE null_child(pid integer REFERENCES parent(id) ON DELETE SET NULL);
INSERT INTO parent VALUES (1), (2);
INSERT INTO cascade_child VALUES (1), (2);
INSERT INTO null_child VALUES (2);
--query
UPDATE parent SET id = 10 WHERE id = 1;
DELETE FROM parent WHERE id = 2;
SELECT (SELECT string_agg(pid::text, ',' ORDER BY pid) FROM cascade_child) AS cascaded, (SELECT count(*) FROM null_child WHERE pid IS NULL) AS nulled;

### D06 boundary block d06-match-simple-partial-null
--setup
CREATE TABLE parent(a integer, b integer, PRIMARY KEY (a, b));
CREATE TABLE child(a integer, b integer, FOREIGN KEY (a, b) REFERENCES parent(a, b) MATCH SIMPLE);
--query
INSERT INTO child VALUES (1, NULL);
SELECT count(*) AS stored FROM child;

### D06 failure block d06-match-full-partial-null
--setup
CREATE TABLE parent(a integer, b integer, PRIMARY KEY (a, b));
CREATE TABLE child(a integer, b integer, FOREIGN KEY (a, b) REFERENCES parent(a, b) MATCH FULL);
--query
INSERT INTO child VALUES (1, NULL);

