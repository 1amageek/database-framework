SELECT TIMESTAMP '2024-01-01 12:00' AT TIME ZONE 'UTC' AS at_utc, to_char(TIMESTAMP '2024-02-03 04:05:06', 'YYYY-MM-DD HH24:MI:SS') AS formatted, to_date('2024-02-29', 'YYYY-MM-DD') AS parsed_date, to_timestamp('2024-02-29 01:02', 'YYYY-MM-DD HH24:MI') AS parsed_ts

