### F04 success query f04-case-and-length
--query
SELECT lower('ÄBC') AS lo, upper('äbc') AS up, length('猫a') AS len, char_length('猫a') AS cl, character_length('猫a') AS chl, octet_length('猫a') AS ol, bit_length('猫a') AS bl

### F04 success query f04-substring-position
--query
SELECT substring('hello' FROM 2 FOR 3) AS s1, substr('hello', 0, 3) AS s2, substring('hello' FROM 4) AS s3, position('l' IN 'hello') AS p1, strpos('hello', 'z') AS p2, substr('猫😀犬', 2, 1) AS emoji

### F04 success query f04-trim-concat-replace
--query
SELECT trim('  x  ') AS t, btrim('xxaxx', 'x') AS bt, ltrim('  x') AS lt, rtrim('x--', '-') AS rt, trim(LEADING 'a' FROM 'aab') AS tl, concat('a', NULL, 1) AS c, concat_ws('-', 'a', NULL, 'b') AS cw, replace('banana', 'an', 'AN') AS r, translate('12345', '143', 'ax') AS tr

### F04 success query f04-split-pad-repeat
--query
SELECT split_part('a,b,c', ',', 2) AS sp, split_part('a,b,c', ',', -1) AS spn, left('hello', 2) AS l, right('hello', -2) AS r, lpad('7', 3, '0') AS lp, rpad('ab', 1) AS rp, repeat('ab', 2) AS rep, reverse('abc') AS rev, ascii('A') AS a, chr(26085) AS ch

### F04 boundary query f04-empty-and-negative
--query
SELECT substring('abc' FROM -1 FOR 3) AS clipped, repeat('x', 0) AS zero, lpad('abc', -1) AS negative_pad, left('abc', -5) AS left_neg, trim('   ') AS blank

### F04 failure query f04-negative-substring-length
--query
SELECT substring('abc' FROM 1 FOR -1)

### F04 failure query f04-split-part-zero
--query
