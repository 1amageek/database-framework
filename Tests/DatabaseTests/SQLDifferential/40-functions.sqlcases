### F11 success query f11-basic-aggregates
--setup
CREATE TABLE v(g integer, x integer, s text, b boolean);
INSERT INTO v VALUES (1, 1, 'a', true), (1, NULL, 'b', false), (2, 3, NULL, true), (2, 3, 'c', NULL);
--query
SELECT g, count(*) AS n, count(x) AS nx, sum(x) AS s, avg(x) AS a, min(s) AS mn, max(x) AS mx, bool_and(b) AS ba, bool_or(b) AS bo, every(b) AS ev FROM v GROUP BY g

### F11 success query f11-ordered-and-filtered-aggregates
--setup
CREATE TABLE v(g integer, x integer, s text);
INSERT INTO v VALUES (1, 2, 'b'), (1, 1, 'a'), (1, 2, 'c'), (2, 5, NULL);
--query
SELECT g, string_agg(s, ',' ORDER BY s DESC) AS sa, array_agg(x ORDER BY x) AS aa, array_agg(DISTINCT x ORDER BY x) AS ad, count(*) FILTER (WHERE x > 1) AS big, sum(DISTINCT x) AS sd FROM v GROUP BY g

### F11 success query f11-bit-and-json-aggregates
--setup
CREATE TABLE v(x integer, k text);
INSERT INTO v VALUES (12, 'a'), (10, 'b'), (6, NULL);
--query
SELECT bit_and(x) AS ba, bit_or(x) AS bo, bit_xor(x) AS bx, json_agg(x ORDER BY x) AS ja, jsonb_agg(k ORDER BY x) AS jba, json_object_agg(x, k ORDER BY x) AS joa, jsonb_object_agg(x, k) AS jboa FROM v

### F11 boundary query f11-empty-input
--setup
CREATE TABLE v(x integer, s text);
--query
SELECT count(*) AS n, count(x) AS nx, sum(x) AS s, avg(x) AS a, string_agg(s, ',') AS sa, array_agg(x) AS aa, bool_and(x > 0) AS ba, json_agg(x) AS ja FROM v

### F11 boundary query f11-widened-result-types
--query
SELECT sum(1::smallint) AS sum_small, sum(1::integer) AS sum_int, sum(1::bigint) AS sum_big, avg(1::integer) AS avg_int, sum(1.5::real) AS sum_real

### F11 failure query f11-object-agg-null-key
--query
SELECT json_object_agg(k, v) FROM (VALUES (NULL::text, 1)) t(k, v)

### F11 failure query f11-distinct-order-mismatch
--query
SELECT array_agg(DISTINCT x ORDER BY y) FROM (VALUES (1, 2)) t(x, y)

### F12 success query f12-statistics
-- Floating aggregates depend on input order, which SQL leaves unspecified
-- without an aggregate ORDER BY.
--setup
CREATE TABLE p(x float8, y float8);
INSERT INTO p VALUES (1, 2), (2, 4), (3, 7), (NULL, 1), (4, NULL);
--query
SELECT var_pop(x ORDER BY x) AS vp, var_samp(x ORDER BY x) AS vs, variance(x ORDER BY x) AS va, stddev_pop(x ORDER BY x) AS sp, stddev_samp(x ORDER BY x) AS ss, stddev(x ORDER BY x) AS sd, corr(y, x ORDER BY x) AS co, covar_pop(y, x ORDER BY x) AS cp, covar_samp(y, x ORDER BY x) AS cs FROM p

### F12 success query f12-regression
--setup
CREATE TABLE p(x float8, y float8);
INSERT INTO p VALUES (1, 2), (2, 4), (3, 7);
--query
SELECT regr_count(y, x) AS rc, regr_avgx(y, x) AS ax, regr_avgy(y, x) AS ay, regr_sxx(y, x) AS sxx, regr_sxy(y, x) AS sxy, regr_syy(y, x) AS syy, regr_slope(y, x) AS slope, regr_intercept(y, x) AS intercept, regr_r2(y, x) AS r2 FROM p

### F12 success query f12-ordered-set
--setup
CREATE TABLE p(x integer);
INSERT INTO p VALUES (1), (2), (2), (10);
--query
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY x) AS median, percentile_disc(0.5) WITHIN GROUP (ORDER BY x) AS disc, percentile_cont(ARRAY[0, 1]) WITHIN GROUP (ORDER BY x) AS bounds, mode() WITHIN GROUP (ORDER BY x) AS most FROM p

### F12 boundary query f12-small-and-numeric-samples
--query
SELECT var_samp(x) AS one_sample, stddev_pop(x) AS one_pop, var_pop(x::numeric) AS numeric_var FROM (VALUES (5)) t(x)

### F12 failure query f12-percentile-out-of-range
--query
SELECT percentile_cont(1.5) WITHIN GROUP (ORDER BY x) FROM (VALUES (1)) t(x)

### F12 failure query f12-ordered-set-without-within-group
--query
SELECT percentile_cont(0.5) FROM (VALUES (1)) t(x)

### F13 success query f13-ranking ordered
--query
SELECT v, row_number() OVER (ORDER BY v) AS rn, rank() OVER (ORDER BY v) AS rk, dense_rank() OVER (ORDER BY v) AS dr, percent_rank() OVER (ORDER BY v) AS pr, cume_dist() OVER (ORDER BY v) AS cd, ntile(2) OVER (ORDER BY v) AS nt FROM (VALUES (10), (20), (20), (30)) t(v) ORDER BY v, rn

### F13 success query f13-offset-and-value ordered
--query
SELECT v, lag(v) OVER w AS lg, lead(v, 2, -1) OVER w AS ld, first_value(v) OVER w AS fv, last_value(v) OVER (w ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS lv, nth_value(v, 2) OVER w AS nv FROM (VALUES (1), (2), (3)) t(v) WINDOW w AS (ORDER BY v) ORDER BY v

### F13 success query f13-aggregate-over-partition ordered
--query
SELECT g, v, avg(v) OVER (PARTITION BY g) AS pa, count(*) OVER () AS total FROM (VALUES (1, 2), (1, 4), (2, 6)) t(g, v) ORDER BY g, v

### F13 failure query f13-ntile-zero
--query
SELECT ntile(0) OVER () FROM (VALUES (1)) t(v)

### F13 failure query f13-nth-value-zero
--query
SELECT nth_value(v, 0) OVER () FROM (VALUES (1)) t(v)

### F13 boundary query f13-lag-past-start ordered
--query
SELECT v, lag(v, 5) OVER (ORDER BY v) AS far, lag(v, 1, 0) OVER (ORDER BY v) AS defaulted FROM (VALUES (1), (2)) t(v) ORDER BY v

