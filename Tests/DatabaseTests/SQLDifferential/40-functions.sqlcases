### F07 success query f07-extract-and-trunc
--query
SELECT EXTRACT(YEAR FROM TIMESTAMP '2024-02-29 13:14:15') AS y, date_part('dow', DATE '2024-02-29') AS dow, EXTRACT(EPOCH FROM TIMESTAMPTZ '1970-01-02 00:00:00+00') AS epoch, date_trunc('month', TIMESTAMP '2024-02-29 13:14:15') AS month_start, date_trunc('hour', TIMESTAMPTZ '2024-02-29 13:14:15+00') AS hour_start

### F07 success query f07-bin-age-make
--query
SELECT date_bin(INTERVAL '15 minutes', TIMESTAMP '2024-01-01 10:37:00', TIMESTAMP '2024-01-01 00:00:00') AS binned, age(TIMESTAMP '2024-03-01', TIMESTAMP '2023-01-15') AS aged, make_date(2024, 2, 29) AS md, make_time(1, 2, 3.5) AS mt, make_timestamp(2024, 1, 2, 3, 4, 5.25) AS mts, make_timestamptz(2024, 1, 2, 3, 4, 5, 'UTC') AS mtz, make_interval(years => 1, days => 2) AS mi

### F07 success query f07-zone-and-format
