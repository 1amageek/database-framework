-- F01-F14 named functions and operators. Every named function appears in at
-- least one success column; overload and failure contracts follow per family.

### F01 success query f01-conditional-functions
--query
SELECT CASE WHEN 1 > 0 THEN 'p' END AS c, COALESCE(NULL::integer, NULL, 3) AS co, NULLIF('a', 'b') AS nf, GREATEST('b', 'a', NULL) AS gs, LEAST(2.5, 1, 3) AS ls

### F01 boundary query f01-all-null-and-short-circuit
--query
SELECT COALESCE(NULL::integer) AS all_null, GREATEST(NULL::integer, NULL) AS no_value, COALESCE(1, 1 / 0) AS short_circuit

### F01 failure query f01-greatest-no-common-type
--query
SELECT GREATEST(1, 'a'::text)

### F02 success query f02-integer-math
--query
SELECT abs(-5) AS a, sign(-3) AS s, div(7, 2) AS d, mod(-7, 3) AS m, gcd(12, 18) AS g, lcm(4, 6) AS l, width_bucket(5, 0, 10, 4) AS wb, power(2, 10) AS p

### F02 success query f02-numeric-math
--query
SELECT ceil(1.2) AS c1, ceiling(-1.2) AS c2, floor(-1.5) AS f, round(1.2345, 2) AS r, trunc(-1.99) AS t1, trunc(1.987, 2) AS t2, sqrt(2::numeric) AS sq, round(cbrt(27::float8)::numeric, 10) AS cb, exp(1::numeric) AS e, ln(10::numeric) AS ln10, log(100) AS lg, log10(1000::numeric) AS l10, log(2, 8) AS lb

### F02 success query f02-scale-functions
--query
SELECT scale(1.2300) AS sc, min_scale(1.2300) AS ms, trim_scale(1.2300) AS ts, power(2::numeric, 0.5) AS frac_power, sign(-0.0::numeric) AS zero_sign, abs(-2::numeric(5,2)) AS scaled_abs

### F02 boundary query f02-numeric-math-stays-decimal
--query
SELECT sqrt(4::numeric) AS sqrt_numeric, power(2::numeric, 2) AS power_numeric, round(1.5::float8) AS float_round, round(2.5::float8) AS banker

### F02 failure query f02-sqrt-negative
--query
SELECT sqrt(-1::numeric)

### F02 failure query f02-ln-zero
--query
SELECT ln(0::numeric)

### F02 failure query f02-mod-zero
--query
SELECT mod(1, 0)

### F02 failure query f02-width-bucket-zero-count
--query
SELECT width_bucket(1, 0, 10, 0)

### F03 success query f03-trigonometry
--query
SELECT pi() AS p, degrees(pi()) AS deg, radians(180) AS rad, sin(0) AS s, cos(0) AS c, tan(0) AS t, asin(1) AS asn, acos(1) AS acs, atan(1) AS atn, atan2(1, 1) AS atn2

### F03 failure query f03-asin-domain
