### F10 success query f10-jsonb-modification
--query
SELECT jsonb_set('{"a": {"b": 1}}', '{a,b}', '2') AS js, jsonb_set('{"a": 1}', '{c}', '3', true) AS created, jsonb_insert('[1, 3]', '{1}', '2') AS ins, jsonb_strip_nulls('{"a": null, "b": [null]}') AS stripped

### F10 success query f10-jsonb-operators
--query
SELECT '{"a": [1, 2]}'::jsonb -> 'a' AS arrow, '{"a": "x"}'::jsonb ->> 'a' AS text_arrow, '{"a": [1, 2]}'::jsonb #> '{a,1}' AS path, '{"a": [1, 2]}'::jsonb #>> '{a,0}' AS text_path, '{"a": 1, "b": 2}'::jsonb @> '{"a": 1}' AS contains, '{"a": 1}'::jsonb <@ '{"a": 1, "b": 2}' AS contained

### F10 success query f10-jsonb-key-and-edit-operators
--query
SELECT '{"a": 1}'::jsonb ? 'a' AS has, '{"a": 1, "b": 2}'::jsonb ?| ARRAY['x', 'b'] AS has_any, '{"a": 1}'::jsonb ?& ARRAY['a', 'b'] AS has_all, '[1]'::jsonb || '[2]'::jsonb AS cat, '{"a": 1, "b": 2}'::jsonb - 'a' AS minus_key, '[1, 2, 3]'::jsonb - -1 AS minus_last, '{"a": {"b": 1}}'::jsonb #- '{a,b}' AS minus_path

### F10 boundary query f10-negative-index-and-missing-path
--query
SELECT '[1, 2, 3]'::jsonb -> -1 AS last_element, '[1]'::jsonb -> 5 AS out_of_range, jsonb_set('[1]', '{5}', '9') AS appended, '{"a": 1}'::jsonb #> '{x,y}' AS missing_path

