### F05 success query f05-like-ilike-similar
--query
SELECT 'abc' LIKE 'a%' AS l1, 'aBc' ILIKE 'A_C' AS l2, 'a%c' LIKE 'a!%c' ESCAPE '!' AS l3, 'abc' NOT LIKE '%d' AS l4, 'abc' SIMILAR TO '(a|b)%' AS s1, 'xyz' NOT ILIKE 'X%' AS l5

### F05 success query f05-regex-operators
--query
SELECT 'abc' ~ 'b' AS r1, 'ABC' ~* 'b' AS r2, 'abc' !~ 'z' AS r3, 'abc' !~* 'B' AS r4, regexp_like('abc', 'B', 'i') AS r5, regexp_replace('aaa', 'a', 'b', 'g') AS r6, regexp_replace('abc', '(b)', '[\1]') AS r7

### F05 success query f05-regex-match-and-split
--query
SELECT regexp_match('foo123bar', '([0-9]+)') AS m, regexp_split_to_array('a1b22c', '[0-9]+') AS parts

### F05 success query f05-regex-matches-rows
--query
SELECT m FROM regexp_matches('a1b2c3', '([a-z])([0-9])', 'g') AS t(m)

### F05 success query f05-regex-split-table
--query
SELECT part FROM regexp_split_to_table('x,y,,z', ',') AS t(part)

### F05 boundary query f05-like-whole-input-and-codepoints
--query
SELECT 'abc' LIKE 'b' AS partial, '猫' LIKE '_' AS one_codepoint, '' LIKE '%' AS empty, NULL LIKE 'a' AS null_input

### F05 failure query f05-invalid-regex
--query
SELECT 'a' ~ '('

### F05 failure query f05-invalid-escape
--query
SELECT 'a' LIKE 'a' ESCAPE 'xy'

### F06 success query f06-binary-functions
