SELECT encode('\x0102ff'::bytea, 'hex') AS hx, encode('hi'::bytea, 'base64') AS b64, decode('0102', 'hex') AS dh, decode('aGk=', 'base64') AS db, get_byte('\x0102'::bytea, 1) AS gb, set_byte('\x0102'::bytea, 0, 255) AS sb, get_bit('\x80'::bytea, 7) AS gbit, set_bit('\x00'::bytea, 0, 1) AS sbit

