### F09 success query f09-json-builders
--query
SELECT to_json('a"b'::text) AS tj, to_jsonb(1.50) AS tjb, row_to_json(ROW(1, 'x')) AS rj, array_to_json(ARRAY[1, 2]) AS aj, json_build_object('a', 1, 'b', NULL) AS jbo, jsonb_build_object('b', 2, 'a', 1) AS jbbo, json_build_array(1, 'x') AS jba, jsonb_build_array(true, NULL) AS jbba

### F09 success query f09-json-inspection
--query
SELECT json_typeof('[1]') AS jt, jsonb_typeof('null') AS jbt, json_array_length('[1,2]') AS jal, jsonb_array_length('[]') AS jbal, json_extract_path('{"a":{"b":1}}', 'a', 'b') AS jep, jsonb_extract_path_text('{"a":{"b":"x"}}', 'a', 'b') AS jbept, json_extract_path_text('{"a":null}', 'a') AS json_null_text

