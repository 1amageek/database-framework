-- M01-M08 data modification, RETURNING, conflicts, writable CTEs, MERGE and TRUNCATE.

### M01 success query m01-insert-values-defaults ordered
--setup
CREATE TABLE items(id integer, label text DEFAULT 'none', amount numeric(6,2) DEFAULT 1.5);
--query
INSERT INTO items(id, amount) VALUES (1, DEFAULT), (2, '3.456') RETURNING id, label, amount
--post
SELECT id, label, amount FROM items ORDER BY id

### M01 success query m01-insert-select-and-default-values
--setup
CREATE TABLE source(v integer);
CREATE TABLE target(v integer DEFAULT 9, w text);
INSERT INTO source VALUES (1), (2);
--query
INSERT INTO target(v) SELECT v * 10 FROM source
--post
SELECT v, w FROM target ORDER BY v

### M01 boundary block m01-default-values-row
--setup
CREATE TABLE target(v integer DEFAULT 9, w text);
--query
INSERT INTO target DEFAULT VALUES;
--post
SELECT v, w FROM target

### M01 failure block m01-batch-is-atomic
--setup
CREATE TABLE items(id integer NOT NULL);
--query
INSERT INTO items VALUES (1), (NULL);
--post
SELECT count(*) AS total FROM items

### M01 failure query m01-arity-mismatch
--setup
CREATE TABLE items(id integer, label text);
--query
INSERT INTO items(id) VALUES (1, 'extra')

### M02 success query m02-update-from-tuple
--setup
CREATE TABLE items(id integer, a integer, b integer);
CREATE TABLE changes(id integer, delta integer);
INSERT INTO items VALUES (1, 1, 10), (2, 2, 20), (3, 3, 30);
INSERT INTO changes VALUES (1, 5), (3, 7);
--query
UPDATE items SET (a, b) = (items.a + c.delta, items.a) FROM changes c WHERE c.id = items.id RETURNING items.id, items.a, items.b
--post
SELECT id, a, b FROM items ORDER BY id

### M02 boundary query m02-old-row-swap
--setup
CREATE TABLE pair(x integer, y integer);
INSERT INTO pair VALUES (1, 2);
--query
UPDATE pair SET x = y, y = x RETURNING x, y

### M02 boundary query m02-correlated-and-default
--setup
CREATE TABLE items(id integer, total integer DEFAULT 0);
CREATE TABLE lines(item integer, qty integer);
INSERT INTO items VALUES (1, 5), (2, 5);
INSERT INTO lines VALUES (1, 3), (1, 4);
--query
UPDATE items SET total = (SELECT sum(qty) FROM lines WHERE lines.item = items.id) WHERE id = 1 RETURNING id, total

### M02 boundary query m02-set-default
--setup
CREATE TABLE items(id integer, total integer DEFAULT 7);
INSERT INTO items VALUES (1, 5);
--query
UPDATE items SET total = DEFAULT RETURNING id, total

### M02 failure block m02-key-change-conflict
--setup
CREATE TABLE items(id integer PRIMARY KEY);
INSERT INTO items VALUES (1), (2);
--query
UPDATE items SET id = 2 WHERE id = 1;
--post
SELECT id FROM items ORDER BY id

### M02 failure query m02-multiple-assignment
--setup
CREATE TABLE items(id integer, a integer);
--query
UPDATE items SET a = 1, a = 2

### M03 success query m03-delete-using-returning
--setup
CREATE TABLE items(id integer, label text);
CREATE TABLE removed(id integer);
INSERT INTO items VALUES (1, 'a'), (2, 'b'), (3, 'c');
INSERT INTO removed VALUES (2), (3), (3);
--query
DELETE FROM items USING removed WHERE removed.id = items.id RETURNING items.id, items.label
--post
SELECT id FROM items

### M03 boundary query m03-correlated-delete-none
--setup
CREATE TABLE items(id integer);
INSERT INTO items VALUES (1);
--query
DELETE FROM items WHERE EXISTS (SELECT 1 WHERE items.id > 5)

### M03 failure block m03-restricted-reference
--setup
CREATE TABLE parent(id integer PRIMARY KEY);
CREATE TABLE child(parent_id integer REFERENCES parent(id));
INSERT INTO parent VALUES (1);
INSERT INTO child VALUES (1);
--query
DELETE FROM parent;
--post
SELECT count(*) AS parents FROM parent

### M04 success query m04-returning-expressions-star
--setup
CREATE TABLE items(id integer, price numeric);
--query
INSERT INTO items VALUES (1, 2.50), (2, 3) RETURNING *, price * 2 AS doubled, id AS id
--post
SELECT count(*) AS total FROM items

### M04 boundary query m04-returning-no-rows
--setup
CREATE TABLE items(id integer);
--query
UPDATE items SET id = id + 1 RETURNING id, id * 2 AS twice

### M04 failure query m04-returning-unknown-column
--setup
CREATE TABLE items(id integer);
--query
INSERT INTO items VALUES (1) RETURNING missing

### M05 success query m05-upsert-excluded ordered
--setup
CREATE TABLE stock(sku text PRIMARY KEY, qty integer);
INSERT INTO stock VALUES ('a', 1), ('b', 1);
--query
INSERT INTO stock VALUES ('a', 5), ('c', 2) ON CONFLICT (sku) DO UPDATE SET qty = stock.qty + EXCLUDED.qty RETURNING sku, qty
--post
SELECT sku, qty FROM stock ORDER BY sku

### M05 success query m05-do-nothing-where
--setup
CREATE TABLE stock(sku text PRIMARY KEY, qty integer);
INSERT INTO stock VALUES ('a', 10);
--query
INSERT INTO stock VALUES ('a', 1), ('b', 2) ON CONFLICT (sku) DO UPDATE SET qty = EXCLUDED.qty WHERE stock.qty < 5 RETURNING sku, qty

### M05 boundary query m05-composite-unique-nulls-distinct
--setup
CREATE TABLE pairs(a integer, b integer, UNIQUE (a, b));
INSERT INTO pairs VALUES (1, NULL);
--query
INSERT INTO pairs VALUES (1, NULL) ON CONFLICT (a, b) DO NOTHING RETURNING a, b

### M05 failure query m05-same-input-twice
--setup
CREATE TABLE stock(sku text PRIMARY KEY, qty integer);
--query
INSERT INTO stock VALUES ('a', 1), ('a', 2) ON CONFLICT (sku) DO UPDATE SET qty = EXCLUDED.qty

### M05 failure query m05-no-matching-constraint
--setup
CREATE TABLE stock(sku text, qty integer);
--query
INSERT INTO stock VALUES ('a', 1) ON CONFLICT (sku) DO NOTHING

### M06 success query m06-writable-cte ordered
--setup
CREATE TABLE src(id integer, v integer);
CREATE TABLE archive(id integer, v integer);
INSERT INTO src VALUES (1, 10), (2, 20), (3, 30);
--query
WITH moved AS (DELETE FROM src WHERE id >= 2 RETURNING id, v), stored AS (INSERT INTO archive SELECT id, v FROM moved RETURNING id) SELECT (SELECT count(*) FROM stored) AS archived, (SELECT count(*) FROM src) AS snapshot_remaining
--post
SELECT id, v FROM archive ORDER BY id

### M06 failure block m06-later-failure-rolls-back
--setup
CREATE TABLE src(id integer PRIMARY KEY);
CREATE TABLE log(id integer);
INSERT INTO src VALUES (1);
--query
WITH logged AS (INSERT INTO log VALUES (1) RETURNING id) INSERT INTO src SELECT id FROM logged;
--post
SELECT count(*) AS logged FROM log

### M06 boundary query m06-exactly-once-effects
--setup
CREATE TABLE counter(id integer);
--query
WITH a AS (INSERT INTO counter VALUES (1) RETURNING id) SELECT (SELECT count(*) FROM a) AS first_read, (SELECT count(*) FROM a) AS second_read
--post
SELECT count(*) AS stored FROM counter

### M07 success query m07-merge-actions
--setup
CREATE TABLE target(id integer PRIMARY KEY, v integer);
CREATE TABLE source(id integer, v integer);
INSERT INTO target VALUES (1, 10), (2, 20), (3, 30);
INSERT INTO source VALUES (1, 11), (2, NULL), (4, 40);
--query
MERGE INTO target t USING source s ON t.id = s.id WHEN MATCHED AND s.v IS NULL THEN DELETE WHEN MATCHED THEN UPDATE SET v = s.v WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v) RETURNING merge_action(), t.id, t.v
--post
SELECT id, v FROM target ORDER BY id

### M07 boundary query m07-do-nothing-and-condition
--setup
CREATE TABLE target(id integer PRIMARY KEY, v integer);
CREATE TABLE source(id integer, v integer);
INSERT INTO target VALUES (1, 10);
INSERT INTO source VALUES (1, 5), (2, 20);
--query
MERGE INTO target t USING source s ON t.id = s.id WHEN MATCHED AND s.v < t.v THEN DO NOTHING WHEN NOT MATCHED AND s.v > 100 THEN INSERT VALUES (s.id, s.v)
--post
SELECT id, v FROM target ORDER BY id

### M07 failure block m07-multiple-source-rows
--setup
CREATE TABLE target(id integer PRIMARY KEY, v integer);
CREATE TABLE source(id integer, v integer);
INSERT INTO target VALUES (1, 10);
INSERT INTO source VALUES (1, 1), (1, 2);
--query
MERGE INTO target t USING source s ON t.id = s.id WHEN MATCHED THEN UPDATE SET v = s.v;
--post
SELECT id, v FROM target

### M08 success block m08-truncate-restart-identity
--setup
CREATE TABLE a(id integer GENERATED ALWAYS AS IDENTITY, v text);
CREATE TABLE b(v text);
INSERT INTO a(v) VALUES ('x'), ('y');
INSERT INTO b VALUES ('z');
--query
TRUNCATE a, b RESTART IDENTITY;
INSERT INTO a(v) VALUES ('after') RETURNING id, v;
--post
SELECT (SELECT count(*) FROM a) AS a_rows, (SELECT count(*) FROM b) AS b_rows

### M08 boundary block m08-truncate-continue-identity
--setup
CREATE TABLE a(id integer GENERATED ALWAYS AS IDENTITY, v text);
INSERT INTO a(v) VALUES ('x'), ('y');
--query
TRUNCATE a CONTINUE IDENTITY;
INSERT INTO a(v) VALUES ('after') RETURNING id;

### M08 failure block m08-truncate-referenced
--setup
CREATE TABLE parent(id integer PRIMARY KEY);
CREATE TABLE child(parent_id integer REFERENCES parent(id));
INSERT INTO parent VALUES (1);
--query
TRUNCATE parent;
--post
SELECT count(*) AS parents FROM parent

### M08 failure block m08-truncate-rollback-restores-identity
--setup
CREATE TABLE a(id integer GENERATED ALWAYS AS IDENTITY, v text);
INSERT INTO a(v) VALUES ('x');
--query
TRUNCATE a RESTART IDENTITY;
INSERT INTO a(v) VALUES ('fresh');
SELECT 1 / 0;
--post
SELECT id, v FROM a ORDER BY id

### M01 boundary query m01-insert-select-duplicate-implicit-names
--setup
CREATE TABLE dup_target(a text, b integer, c integer);
--query
INSERT INTO dup_target SELECT 'one', 1 + 2, 2 + 2 RETURNING *

### M02 boundary query m02-update-from-duplicate-implicit-names-returning
--setup
CREATE TABLE dup_update(id integer PRIMARY KEY, v integer);
INSERT INTO dup_update VALUES (1, 10);
--query
UPDATE dup_update SET v = s.k FROM (SELECT 1 + 1 AS k, 2 + 2, 3 + 3) AS s WHERE id = 1 AND s.k = 2 RETURNING s.*
